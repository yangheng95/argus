  bodySmall: '400 12px/16px Inter, -apple-system, BlinkMacSystemFont, sans-serif',
  label: '500 13px/18px Inter, -apple-system, BlinkMacSystemFont, sans-serif',
  button: '500 14px/20px Inter, -apple-system, BlinkMacSystemFont, sans-serif',
