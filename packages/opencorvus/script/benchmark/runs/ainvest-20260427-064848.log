```text
mirror/                          # Mirror toolchain artifacts (from goal_extract_mirror)
  reference.png                  # Screenshot of reference page
  extracted-page.json            # Raw extraction data
  page-ir.xml                    # Compiled intermediate representation
  scaffold.json                  # Project scaffold
  design-tokens.ts               # Design tokens (colors, spacing, typography)
  shared-context.md              # Shared context for implementation
  images/                        # Extracted assets

src/
  server/                        # Backend Hono API (goal_backend_api)
    index.ts                     # Server entry point
    routes/
      stock.ts                   # Stock data endpoints
      watchlist.ts               # Watchlist endpoints
    types/
      stock.ts                   # Shared TypeScript types
    data/
      mockData.ts                # Mock data for NVDA and other stocks
    tests/
      api.test.ts                # API unit tests

  components/                    # React components (goal_frontend_ui)
    Header.tsx                   # Top navigation bar
    Sidebar.tsx                  # Left chart tools sidebar
    Chart.tsx                    # TradingView chart component
    Watchlist.tsx                # Right panel watchlist
    CookieBanner.tsx             # Bottom cookie consent
    StockItem.tsx                # Individual stock list item
    TabPanel.tsx                 # Tab navigation component
    OverviewCard.tsx             # Stock overview card
    BuySellBar.tsx               # BUY/SELL progress bar
  
  hooks/                         # Custom React hooks
    useStockData.ts              # Stock data fetching
    useChart.ts                  # Chart initialization
  
  types/                         # Frontend types
    index.ts                     # Type exports
  
  lib/                           # Utility libraries
    utils.ts                     # Helper functions
  
  styles/                        # Additional styles
    global.css                   # Global CSS
  
  App.tsx                        # Main app component
  main.tsx                       # Entry point
  index.html                     # HTML template

tests/                           # Integration and E2E tests (goal_tests)
  integration/
    api.test.ts                  # API integration tests
    components.test.ts           # Component integration tests
  e2e/
    user-flows.test.ts           # End-to-end user flow tests
    visual.test.ts               # Visual regression tests
