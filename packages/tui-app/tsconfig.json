{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"]
  },
  "include": ["src/**/*"]
}
