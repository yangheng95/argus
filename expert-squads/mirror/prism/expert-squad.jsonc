{
  "schema_version": 1,
  "namespace": "mirror",
  "id": "prism",
  "name": "Mirror Prism",
  "label": "Mirror Prism",
  "description": "A lean fixed-profile Mirror Prism squad that converges any evidenced reference product into one complete original AInvest subsystem, including every business-required associated subpage, shared capability, cross-route state, and end-to-end journey, through source discovery, AInvest authority mapping, planning, Product Requirements Documents, rendered design, implementation, and MirrorTest acceptance.",
  "version": "2026.08.07.1",
  "product_pillars": ["code"],
  "readme": "README.md",
  "selector": {
    "summary": "Use to converge any evidenced reference product into one complete original AInvest subsystem inside a fixed Mirror Prism profile.",
    "selection_guidance": "Select Mirror Prism when an arbitrary reference product must become a complete AInvest subsystem through Product Requirements, original AInvest design, implementation, and acceptance. The supplied page is a discovery entry: the delivery includes every evidenced business-required associated subpage and their shared journeys. Do not select it for clone, replica, port, screenshot-parity, or reference-parity delivery; the dedicated Frontend Replica Expert Squad owns those requests.",
    "instructions": "selector.md"
  },
  "capability_projection": {
