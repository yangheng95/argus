          "mirror-watch/shared/mirror-design",
        ],
        "package_tool_refs": [
          "mirror-watch/shared/ifind-search",
          "mirror-watch/shared/publish-research-delivery",
        ],
        "default_skill_refs": [],
        "default_tool_refs": [],
