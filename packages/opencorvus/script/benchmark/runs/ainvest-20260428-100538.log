// backend/src/routes/stock.ts

// GET /api/stock/:symbol
// Returns: Stock
interface GetStockResponse {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  volume: number;
  high: number;
  low: number;
  open: number;
  close: number;
  marketStatus: 'open' | 'closed' | 'extended';
  exchange: string;
}

// GET /api/stock/:symbol/history?timeframe=1D|1W|1M|3M|6M|1Y
// Returns: ChartData[]
interface GetHistoryResponse {
  data: Array<{
    time: number;
    open: number;
    high: number;
    low: number;
    close: number;
    volume: number;
  }>;
}

// GET /api/stock/:symbol/indicators?types=ma,macd,rsi,bollinger
// Returns: TechnicalIndicator[]
interface GetIndicatorsResponse {
  indicators: TechnicalIndicator[];
}

// WebSocket /ws/stocks
// Messages: { type: 'price', symbol: string, price: number, change: number, timestamp: number }
