        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "mirror-watch-workflow-architect": {
        "label": "Mirror Watch Workflow Architect",
        "description": "Creates the sole final-report Delivery Slice revision while once-per-Task workflow producers own research and survey Artifacts.",
        "base_role": "architect",
        "prompt": "agents/mirror-watch-workflow-architect/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "package_skill_refs": ["mirror-watch/shared/delivery-contract"],
