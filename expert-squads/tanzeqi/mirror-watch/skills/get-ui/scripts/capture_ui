#!/usr/bin/env python3
"""
Capture UI Screenshot from a website using browser agent API.
Optionally answer questions about the captured UI.

Usage:
    # Capture only (no query)
    python capture_ui.py --url "https://example.com" --api-endpoint "https://browser.example/api/browser-agent"

    # Capture and answer a question
    python capture_ui.py --url "https://example.com" --query "What are the main headlines?" --api-endpoint "https://browser.example/api/browser-agent"
"""

import argparse
import json
import sys
import urllib.request
import urllib.error


def capture_ui(url: str, api_endpoint: str, query: str = None, width: int = 1920, height: int = 1080):
    """Call browser agent API to capture UI screenshot and optionally answer questions."""

    headers = {'Content-Type': 'application/json'}

    base_url = api_endpoint.rstrip('/')
    if not base_url.endswith('/api/browser-agent'):
        raise ValueError('api_endpoint must end with /api/browser-agent')

    if query:
        api_endpoint = f'{base_url}/save-query'
        payload = {
            'img_url': url,
            'width': width,
            'height': height,
            'query': query,
        }
    else:
        api_endpoint = f'{base_url}/save-url'
        payload = {'img_url': url}

    try:
        req = urllib.request.Request(api_endpoint, data=json.dumps(payload).encode('utf-8'), headers=headers, method='POST')

        with urllib.request.urlopen(req, timeout=600) as response:
            result = json.loads(response.read().decode('utf-8'))

            # Check for API-level errors
            if result.get('error'):
                print(f'API Error: {result["error"]}', file=sys.stderr)
                sys.exit(1)

            if 'image_url' in result and result['image_url']:
                print('Successfully captured UI: ', str(result['image_url']))
            else:
                raise ValueError(f'Failed to capture UI of {url}.')

            # If query was provided, print answer (or note it's unavailable)
            if query:
                print('\n--- Answer ---')
                if result.get('anwser'):
                    print(result['anwser'])
                else:
                    print('(No answer available)')

    except urllib.error.HTTPError as e:
        error_body = e.read().decode('utf-8')
        print(f'HTTP Error {e.code}: {error_body}', file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f'URL Error: {e.reason}', file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f'Error: {e}', file=sys.stderr)
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(description='Capture UI workflow from a website')
    parser.add_argument('--url', required=True, help='Target website URL')
    parser.add_argument('--query', default=None, help='Optional question about the captured UI')
    parser.add_argument('--width', type=int, default=1920, help='Screenshot width in pixels (default: 1920)')
    parser.add_argument('--height', type=int, default=1080, help='Screenshot height in pixels (default: 1080)')
    parser.add_argument('--api-endpoint', required=True, help='Exact browser agent API base endpoint')

    args = parser.parse_args()

    capture_ui(args.url, args.api_endpoint, args.query, args.width, args.height)

if __name__ == '__main__':
    main()
