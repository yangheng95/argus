```ts
// From goal_extract → consumed by goal_frontend

export interface DesignTokenRegistry {
  colors: {
    background: '#FFFFFF';
    surface: '#F8F9FA';
    border: '#E5E7EB';
    textPrimary: '#1F2937';
    textSecondary: '#6B7280';
    success: '#22C55E';  // Up candles, buy
    error: '#EF4444';    // Down candles, sell
    primary: '#000000';  // Buttons
    accent: '#3B82F6';   // Unlock Now
    chartGrid: '#F3F4F6';
    notificationBg: '#EFF6FF';
    ma1: '#8B5CF6';      // Purple
    ma2: '#F59E0B';      // Orange
    ma3: '#06B6D4';      // Cyan
    ma4: '#EC4899';      // Pink
    ma5: '#6366F1';      // Indigo
  };
  typography: {
    headingLg: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 700, fontSize: '24px', lineHeight: '32px' };
    headingMd: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 600, fontSize: '18px', lineHeight: '24px' };
    body: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 400, fontSize: '14px', lineHeight: '20px' };
    label: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 500, fontSize: '12px', lineHeight: '16px' };
    button: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 600, fontSize: '14px', lineHeight: '20px' };
    caption: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 400, fontSize: '11px', lineHeight: '14px' };
    change: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 500, fontSize: '14px', lineHeight: '18px' };
  };
  spacing: {
    headerHeight: '56px';
    leftSidebarWidth: '48px';
    rightSidebarWidth: '320px';
    xs: '4px';
    sm: '8px';
    md: '16px';
    lg: '24px';
  };
}
