}): JSX.Element

export function Toast(props: {
  title: string
  description?: string
  variant: ToastVariant
  onClose?: () => void
}): JSX.Element

export function EmptyState(props: {
  icon: unknown
  title: string
  description?: string
  action?: { label: string; onClick: () => void }
}): JSX.Element

export function StatusBadge(props: {
  status?: StatusState
  sentiment?: SentimentState
}): JSX.Element

export function DataCard(props: {
  label: string
  value: number | string
  trend?: 'up' | 'down' | 'flat'
  animated?: boolean
}): JSX.Element

export function ConfirmDialog(props: {
  open: boolean
  title: string
  children: React.ReactNode
  onConfirm: () => void
  onCancel: () => void
}): JSX.Element
