/**
 * Mock data for user login status (用户登录状态)
 * Simulates Baidu user authentication state
 */

/**
 * Get current user status
 * @returns {{ loggedIn: boolean; avatar?: string; nickname?: string }}
 */
export function getUserStatus() {
  return {
    loggedIn: false,
    avatar: undefined,
    nickname: undefined,
  };
}

/**
 * Mock login action
 * @returns {{ success: boolean; message: string }}
 */
export function mockLogin() {
  console.log('[Mock] 登录按钮被点击 — 弹出登录对话框');
  return { success: true, message: 'Mock: 登录弹窗已打开' };
}

/**
 * Mock logout action
 * @returns {{ success: boolean; message: string }}
 */
export function mockLogout() {
  console.log('[Mock] 用户已登出');
