    "virtual_workflows": {
      "mirror-prism-ainvest": {
        "label": "Mirror Prism Universal AInvest Delivery",
        "description": "One fixed-profile Task observes any authorized reference product and converges the evidence-backed complete subsystem closure into AInvest Product Requirements, original AInvest design, production implementation, and independent MirrorTest acceptance.",
        "nodes": {
          "prism-source-observer": {
            "agent_id": "prism-source-observer",
            "description": "Observes every operator-authorized reference product and named comparison scope before AInvest convergence planning.",
            "depends_on": [],
          },
          "mirror-prd-general-researcher": {
            "agent_id": "mirror-prd-general-researcher",
            "description": "Derives the complete reference route set, evidence-backed subsystem closure, delivery surfaces, shared capabilities, connected journeys, and canonical system-project contract from accepted source observation.",
            "depends_on": [
              "prism-source-observer"
            ],
          },
          "mirror-prd-ainvest-feature-mapper": {
            "agent_id": "mirror-prd-ainvest-feature-mapper",
            "description": "Maps route-applicable AInvest capabilities and persists the sole product/design authority artifact.",
            "depends_on": [
              "mirror-prd-general-researcher"
            ],
          },
          "mirror-prd-stage-planner": {
            "agent_id": "mirror-prd-stage-planner",
            "description": "Publishes one ordinary non-Goal AInvest delivery plan that owns the complete subsystem closure from the system contract and product/design authority.",
            "depends_on": [
              "mirror-prd-ainvest-feature-mapper"
            ],
          },
          "mirror-prd-ui-researcher": {
            "agent_id": "mirror-prd-ui-researcher",
            "description": "Produces product-observation, interaction, accessibility, screenshot, diagnostic, and asset-candidate evidence for every AInvest delivery surface without assigning visual-parity authority.",
            "depends_on": [
              "mirror-prd-stage-planner"
            ],
          },
          "mirror-prd-asset-curator": {
            "agent_id": "mirror-prd-asset-curator",
            "description": "Materializes approved bytes and builds the accepted asset ledger from the current AInvest delivery-surface evidence packet.",
            "depends_on": [
              "mirror-prd-ui-researcher"
            ],
          },
          "mirror-prd-author": {
            "agent_id": "mirror-prd-author",
            "description": "Authors the complete connected AInvest subsystem Product Requirements Document set from the system contract, subsystem closure, mapper authority, surface evidence, and asset ledger.",
            "depends_on": [
              "mirror-prd-ainvest-feature-mapper",
              "mirror-prd-asset-curator",
              "mirror-prd-general-researcher",
              "mirror-prd-ui-researcher"
            ],
          },
          "mirror-prd-reviewer": {
            "agent_id": "mirror-prd-reviewer",
            "description": "Independently checks subsystem-closure completeness, connected behavior, and the AInvest Product Requirements Documents' wiki/design-system traceability.",
            "depends_on": [
              "mirror-prd-ainvest-feature-mapper",
              "mirror-prd-author"
            ],
          },
          "mirror-design-page-designer": {
            "agent_id": "mirror-design-page-designer",
            "description": "Produces one coherent design subsystem for every closure member, shared shell/state, and connected journey once for the Task through frontend_design mode greenfield_original.",
            "depends_on": [
              "mirror-prd-ainvest-feature-mapper",
              "mirror-prd-reviewer"
            ],
          },
          "mirror-design-visual-reviewer": {
            "agent_id": "mirror-design-visual-reviewer",
            "description": "Renders and independently reviews the complete connected AInvest subsystem design with fresh task-scoped browser evidence.",
            "depends_on": [
              "mirror-design-page-designer"
            ],
          },
          "mirror-design-integrator": {
            "agent_id": "mirror-design-integrator",
            "description": "Reviews complete AInvest subsystem closure, associated-subpage coverage, shared navigation/state, asset consistency, diagnostics, and cross-route design integrity.",
            "depends_on": [
              "mirror-design-visual-reviewer"
            ],
          },
          "mirror-code-implementer": {
            "agent_id": "mirror-code-implementer",
            "description": "Implements the entire closure-owned AInvest Product Requirements/design set as one connected subsystem in the existing application architecture.",
            "depends_on": [
              "mirror-design-integrator"
            ],
          },
          "mirror-code-visual-reviewer": {
            "agent_id": "mirror-code-visual-reviewer",
            "description": "Reviews every implemented closure member and connected journey against the approved subsystem design using real browser evidence.",
            "depends_on": [
              "mirror-code-implementer"
            ],
          },
          "mirror-code-integration-implementer": {
            "agent_id": "mirror-code-integration-implementer",
            "description": "Materializes the complete AInvest router, shell, shared services/state, deep links, recovery paths, and cross-route journeys for the reviewed subsystem implementation.",
            "depends_on": [
              "mirror-code-visual-reviewer"
            ],
          },
          "mirror-code-integrity-reviewer": {
            "agent_id": "mirror-code-integrity-reviewer",
            "description": "Runs repository-native validation and verifies complete AInvest subsystem behavior, closure-member coverage, connected integration, and evidence integrity.",
            "depends_on": [
              "mirror-code-integration-implementer"
            ],
          },
          "opentest-test-implementer": {
            "agent_id": "opentest-test-implementer",
            "description": "Extracts the successful AInvest non-UI contract and implements its positive acceptance tests.",
            "depends_on": [
              "mirror-code-integration-implementer"
            ],
          },
          "opentest-integrity-reviewer": {
            "agent_id": "opentest-integrity-reviewer",
            "description": "Reviews AInvest test validity, execution evidence, protocol conformance, and acceptance claims.",
            "depends_on": [
              "opentest-test-implementer"
            ],
          },
          "opentest-visual-reviewer": {
            "agent_id": "opentest-visual-reviewer",
            "description": "Performs live interaction across every AInvest subsystem closure member and end-to-end journey, captures current screenshots, and personally reviews the connected experience.",
            "depends_on": [
              "opentest-test-implementer"
            ],
          }
        }
      }
    }
  }
}
