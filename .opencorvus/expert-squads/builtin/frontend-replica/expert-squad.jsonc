{
  "schema_version": 1,
  "id": "frontend-replica",
  "label": "Frontend Replica",
  "description": "Source URL/reference-screenshot replica, desktop surface ledger, bounded evidence-backed acceptance, source evidence, and rendered proof expert squad.",
  "version": "2026.07.05",
  "readme": "README.md",
  "selector": {
    "summary": "Source URL/reference-screenshot replica, desktop surface ledger, bounded evidence-backed acceptance, source evidence, and rendered proof expert squad.",
    "selection_guidance": "Use select_expert_squad with profile_id frontend-replica when the user request matches this expert squad.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "role_base": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "refine",
        "browser_preview",
        "bash"
      ]
    },
    "agents": {
      "coding": {
        "role_base": true
      },
      "coding-assistant": {
        "role_base": true
      },
      "general": {
        "role_base": true
      },
      "explore": {
        "role_base": true
      },
      "mission": {
        "role_base": true
      },
      "intent-analysis": {
        "role_base": true
      },
      "requirements": {
        "role_base": true
      },
      "architect": {
        "role_base": true
      },
      "frontend-design": {
        "role_base": true,
        "default_tool_refs": [
          "default/tool/web_clone_generate_source_project",
          "default/tool/create_frontend_skeleton_project",
          "default/tool/create_visual_region_coordinate_atlas",
          "default/tool/create_visual_region_binding_package",
          "default/tool/record_frontend_region_selection",
          "default/tool/record_frontend_replacement_result"
        ]
      },
      "frontend-research": {
        "role_base": true
      },
      "goal-workload-analyst": {
        "role_base": true
      },
      "build": {
        "role_base": true
      },
      "visual-qa": {
        "role_base": true,
        "default_tool_refs": [
          "default/tool/browser_preview_reference_regions",
          "default/tool/browser_preview_compare_scroll_slices",
          "default/tool/browser_preview_layout_geometry"
        ]
      },
      "integrity": {
        "role_base": true
      },
      "orchestrator": {
        "role_base": true
      }
    }
  },
  "agents": {
    "coding": {
      "prompt": "agents/coding/system.md"
    },
    "coding-assistant": {
      "prompt": "agents/coding-assistant/system.md"
    },
    "general": {
