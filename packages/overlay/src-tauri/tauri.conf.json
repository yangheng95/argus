{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openlens-overlay",
  "version": "0.1.0",
  "identifier": "dev.openlens.overlay",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "openlens-overlay",
        "url": "index.html",
        "width": 360,
        "height": 60,
        "x": -9999,
        "y": -9999,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  }
}
