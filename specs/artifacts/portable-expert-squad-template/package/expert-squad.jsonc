{
  "schema_version": 1,
  "namespace": "template",
  "id": "portable-template",
  "label": "Portable Expert Squad Template",
  "description": "Copy-and-edit template for portable OpenCorvus expert squads; prune unused roles before installation.",
  "version": "2026.07.07",
  "readme": "README.md",
  "selector": {
    "summary": "Template selector. Replace this before installation; do not select an unedited template for production work.",
    "selection_guidance": "After this template is renamed and specialized, use select_expert_squad with the new profile_id when the task matches its domain.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "role_base": false,
      "built_in_tool_ids": [
        "select_expert_squad",
        "skill",
        "question",
        "read_context",
        "dispatch_agent",
        "manage_task",
        "refine",
        "wait",
        "browser_preview",
        "bash",
        "respond_agent_coordination",
        "cancel_subagent"
      ],
      "package_skill_refs": [
        "portable-template/shared/expert-squad-authoring"
      ]
    },
    "agents": {
      "coding": {
        "role_base": true
      },
      "coding-assistant": {
        "role_base": true
      },
      "build": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "visual-qa": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "general": {
        "role_base": true
      },
      "explore": {
        "role_base": true
      },
      "orchestrator": {
        "role_base": true
      },
      "mission": {
        "role_base": true
      },
      "requirements": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "architect": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "frontend-design": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "intent-analysis": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "integrity": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "fact-check": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "deep-research": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "frontend-research": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      },
      "goal-workload-analyst": {
        "role_base": true,
        "package_skill_refs": [
          "portable-template/shared/expert-squad-authoring"
        ]
      }
    }
  },
  "agents": {
    "orchestrator": {
      "prompt": "agents/orchestrator/system.md",
      "skill_refs": [
        "portable-template/shared/expert-squad-authoring"
      ]
    }
  },
  "virtual_agents": {
    "build": {
      "id": "portable-build",
      "label": "Portable Build",
      "description": "Template virtual agent identity projected onto the existing build base role.",
      "prompt": "virtual-agents/build/system.md"
    },
    "visual-qa": {
      "id": "portable-visual-qa",
      "label": "Portable Visual Qa",
      "description": "Template virtual agent identity projected onto the existing visual-qa base role.",
