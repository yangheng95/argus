              { en: "Provider concerns do not decide workflow sequencing.", zh: "Provider 层不决定 workflow 顺序。" },
            ],
            subsystems: [
              { id: "vercel-ai", title: { en: "Vercel AI SDK router", zh: "Vercel AI SDK router" }, summary: { en: "Common transport for model calls.", zh: "模型调用的公共传输。" }, sources: ["packages/opencorvus/src/provider"] },
            ],
          },
          {
            id: "extension-planes",
            title: { en: "Plugin / MCP / ACP", zh: "Plugin / MCP / ACP" },
            summary: { en: "Code hooks, tool servers, and editor protocol surfaces.", zh: "代码 hook、tool server 与编辑器协议表面。" },
            sources: ["packages/plugin", "packages/opencorvus/src/mcp", "packages/opencorvus/src/acp"],
            details: [
              { en: "Plugins add local hooks and tools; MCP supplies external tools; ACP integrates editors.", zh: "Plugin 添加本地 hook 与 tool；MCP 提供外部 tool；ACP 集成编辑器。" },
              { en: "These planes remain subordinate to task facts and orchestrator decisions.", zh: "这些扩展面从属于 task fact 与 orchestrator 决策。" },
            ],
            subsystems: [
              { id: "mcp-client-server", title: { en: "MCP client/server", zh: "MCP client/server" }, summary: { en: "Tool discovery and invocation plane.", zh: "tool discovery 与 invocation 平面。" }, sources: ["packages/opencorvus/src/mcp"] },
              { id: "acp", title: { en: "ACP", zh: "ACP" }, summary: { en: "Editor integration protocol.", zh: "编辑器集成协议。" }, sources: ["packages/opencorvus/src/acp"] },
            ],
          },
        ],
      },
      {
        id: "docs-operations",
        lane: { en: "Ops", zh: "文档" },
        title: { en: "Docs & Operations", zh: "文档与运维" },
        summary: {
          en: "Starlight docs, generated API reference, benchmark probes, and project specs keep the architecture auditable.",
          zh: "Starlight docs、生成的 API reference、benchmark probe 与项目方案让架构可审计。",
        },
        tone: "review",
        position: { col: 6, row: 3 },
        views: ["overview", "data", "overlay"],
        sources: [
          "packages/web/src/content/docs/**",
          "packages/web/astro.config.mjs",
          "script/docs/render-api-md.ts",
          "packages/opencorvus/script/benchmark/**",
          "specs/new-arch/**",
        ],
        constraints: [
          { en: "Generated API reference comes from OpenAPI scripts, not manual edits.", zh: "生成的 API reference 来自 OpenAPI 脚本，不手写覆盖。" },
          { en: "Architecture changes require disk plans, callpoint inventory, tests, and review evidence.", zh: "架构改动需要落盘方案、调用点清单、测试与复核证据。" },
        ],
        components: [
          {
            id: "web-docs",
            title: { en: "Starlight docs", zh: "Starlight docs" },
            summary: { en: "Public docs site and concept pages.", zh: "公共文档站点与概念页。" },
            sources: ["packages/web/src/content/docs/**", "packages/web/astro.config.mjs"],
            details: [
              { en: "Concept pages explain current runtime facts and link source paths.", zh: "概念页解释当前 runtime facts 并链接源码路径。" },
              { en: "This explorer is registered beside the architecture overview.", zh: "本 explorer 注册在 architecture overview 旁边。" },
            ],
            subsystems: [
              { id: "api-docs", title: { en: "Generated API docs", zh: "Generated API docs" }, summary: { en: "OpenAPI render script produces reference pages.", zh: "OpenAPI render 脚本生成 reference 页面。" }, sources: ["script/docs/render-api-md.ts"] },
            ],
          },
          {
            id: "specs-benchmark",
            title: { en: "Specs and benchmark probes", zh: "Specs / benchmark probes" },
            summary: { en: "New-architecture decisions and benchmark tools record acceptance discipline.", zh: "new-architecture 决策与 benchmark 工具记录验收纪律。" },
            sources: ["specs/new-arch/**", "packages/opencorvus/script/benchmark/**"],
            details: [
              { en: "Specs record historical constraints and current root-repair plans.", zh: "spec 记录历史约束与当前根因修复方案。" },
              { en: "Benchmark probes are used only with real checker/evidence paths.", zh: "benchmark probe 只在真实 checker/evidence 路径上使用。" },
            ],
            subsystems: [
              { id: "new-arch", title: { en: "new-arch specs", zh: "new-arch specs" }, summary: { en: "Current design and repair records.", zh: "当前设计与修复记录。" }, sources: ["specs/new-arch/**"] },
            ],
          },
        ],
      },
    ]

    const edges = [
      { id: "ingress-engine", from: "input-control", to: "engine-core", label: { en: "create task / message", zh: "创建 task / message" }, views: ["overview", "runtime"], sources: ["packages/opencorvus/src/task-api/index.ts"] },
      { id: "engine-orchestrator", from: "engine-core", to: "orchestrator-host", label: { en: "snapshot + wake", zh: "快照 + 唤醒" }, views: ["overview", "runtime", "data"], sources: ["packages/opencorvus/src/engine/describe.ts", "packages/opencorvus/src/orchestrator/loop.ts"] },
      { id: "orchestrator-agents", from: "orchestrator-host", to: "worker-agents", label: { en: "typed tools", zh: "typed tools" }, views: ["overview", "runtime", "a2a"], sources: ["packages/opencorvus/src/orchestrator/tools.ts"] },
      { id: "agents-execution", from: "worker-agents", to: "worktree-execution", label: { en: "build dispatch", zh: "build dispatch" }, views: ["overview", "runtime"], sources: ["packages/opencorvus/src/orchestrator/tools.ts", "packages/opencorvus/src/build/agent.ts"] },
      { id: "execution-evidence", from: "worktree-execution", to: "verification-evidence", label: { en: "diff + runtime facts", zh: "diff + runtime facts" }, views: ["overview", "runtime", "data"], sources: ["packages/opencorvus/src/verification/**"] },
      { id: "evidence-orchestrator", from: "verification-evidence", to: "orchestrator-host", label: { en: "review verdict", zh: "复核 verdict" }, views: ["overview", "runtime", "a2a"], sources: ["packages/opencorvus/src/integrity", "packages/opencorvus/src/visual-qa"] },
      { id: "engine-overlay", from: "engine-core", to: "overlay-projection", label: { en: "SSE + board", zh: "SSE + board" }, views: ["overview", "overlay", "data"], sources: ["packages/overlay/src/services/events.ts", "packages/overlay/src/services/tree-writer.ts"] },
      { id: "evidence-overlay", from: "verification-evidence", to: "overlay-projection", label: { en: "screenshots + reports", zh: "截图 + report" }, views: ["overview", "overlay"], sources: ["packages/overlay/src/components/BrowserPreviewPanel.tsx", "packages/overlay/src/components/ScreenshotBrowserPanel.tsx"] },
      { id: "providers-agents", from: "providers-extensions", to: "worker-agents", label: { en: "streaming LLM + tools", zh: "streaming LLM + tools" }, views: ["overview", "runtime", "data"], sources: ["packages/opencorvus/src/provider/**", "packages/opencorvus/src/agent/tool-pool-contract.ts"] },
      { id: "docs-evidence", from: "docs-operations", to: "verification-evidence", label: { en: "specs + checks", zh: "specs + checks" }, views: ["overview", "data", "overlay"], sources: ["packages/web/src/content/docs/**", "specs/new-arch/**"] },
      { id: "a2a-engine", from: "worker-agents", to: "engine-core", label: { en: "agent_coordination_* artifacts", zh: "agent_coordination_* artifacts" }, views: ["a2a", "data"], sources: ["packages/opencorvus/src/engine/agent-coordination.ts"] },
      { id: "a2a-orchestrator", from: "engine-core", to: "orchestrator-host", label: { en: "pending coordination", zh: "pending coordination" }, views: ["a2a"], sources: ["packages/opencorvus/src/engine/describe.ts", "packages/opencorvus/src/orchestrator/tools.ts"] },
    ]

    const compactPositions = {
      "input-control": { col: 1, row: 1 },
      "engine-core": { col: 2, row: 1 },
      "orchestrator-host": { col: 3, row: 1 },
      "worker-agents": { col: 1, row: 2 },
      "worktree-execution": { col: 2, row: 2 },
      "verification-evidence": { col: 3, row: 2 },
      "overlay-projection": { col: 1, row: 3 },
      "providers-extensions": { col: 2, row: 3 },
      "docs-operations": { col: 3, row: 3 },
    }

    const roots = document.querySelectorAll("[data-oc-architecture-explorer]")
    for (const root of roots) initExplorer(root)

    function initExplorer(root) {
      const locale = root.dataset.locale
      if (locale !== "en" && locale !== "zh") throw new Error(`architecture explorer: invalid locale ${String(locale)}`)
      const domainById = new Map(domains.map((domain) => [domain.id, domain]))
      const edgeById = new Map(edges.map((edge) => [edge.id, edge]))
      const state = {
        view: "overview",
        domainID: "orchestrator-host",
        componentID: "",
        subsystemID: "",
        edgeID: "",
        query: "",
      }

      const els = {
        search: must(root.querySelector("[data-arch-search]"), "search input"),
        viewControls: must(root.querySelector("[data-arch-view-controls]"), "view controls"),
        reset: must(root.querySelector("[data-arch-reset]"), "reset button"),
        path: must(root.querySelector("[data-arch-path]"), "path"),
        rail: must(root.querySelector("[data-arch-rail]"), "rail"),
        canvas: must(root.querySelector("[data-arch-canvas]"), "canvas"),
        links: must(root.querySelector("[data-arch-links]"), "links"),
        map: must(root.querySelector("[data-arch-map]"), "map"),
        edgeStrip: must(root.querySelector("[data-arch-edge-strip]"), "edge strip"),
        layerPanel: must(root.querySelector("[data-arch-layer-panel]"), "layer panel"),
        inspector: must(root.querySelector("[data-arch-inspector]"), "inspector"),
        evidence: must(root.querySelector("[data-arch-evidence]"), "evidence"),
      }

      els.search.setAttribute("placeholder", locale === "zh" ? "例如：integrity、cardTreeStore、A2A" : "Try: integrity, cardTreeStore, A2A")

      els.search.addEventListener("input", () => {
        state.query = els.search.value.trim().toLowerCase()
        state.edgeID = ""
        ensureVisibleSelection()
        render()
      })

      els.reset.addEventListener("click", () => {
        state.view = "overview"
        state.domainID = "orchestrator-host"
        state.componentID = ""
        state.subsystemID = ""
        state.edgeID = ""
        state.query = ""
        els.search.value = ""
        render()
      })

      els.viewControls.addEventListener("click", (event) => {
        const button = event.target.closest("[data-arch-view]")
        if (!button) return
        state.view = button.dataset.archView
        state.edgeID = ""
        ensureVisibleSelection()
        render()
      })

      els.rail.addEventListener("click", (event) => {
        const button = event.target.closest("[data-arch-domain]")
        if (!button) return
        selectDomain(button.dataset.archDomain)
      })

      els.rail.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowRight" && event.key !== "ArrowUp" && event.key !== "ArrowLeft") return
        const buttons = [...els.rail.querySelectorAll("[data-arch-domain]:not([hidden])")]
        const index = buttons.indexOf(document.activeElement)
        if (index < 0) return
        event.preventDefault()
        const delta = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1
        const nextIndex = (index + delta + buttons.length) % buttons.length
        buttons[nextIndex].focus()
      })

      els.map.addEventListener("click", (event) => {
        const button = event.target.closest("[data-arch-domain]")
        if (!button) return
        selectDomain(button.dataset.archDomain)
      })

      els.edgeStrip.addEventListener("click", (event) => {
        const button = event.target.closest("[data-arch-edge]")
        if (!button) return
        const edge = edgeById.get(button.dataset.archEdge)
        if (!edge) throw new Error(`architecture explorer: missing edge ${button.dataset.archEdge}`)
        state.edgeID = edge.id
        state.componentID = ""
        state.subsystemID = ""
        render()
      })

      els.layerPanel.addEventListener("click", (event) => {
        const componentButton = event.target.closest("[data-arch-component]")
        if (componentButton) {
          state.componentID = componentButton.dataset.archComponent
          state.subsystemID = ""
          state.edgeID = ""
          render()
          return
        }
        const subsystemButton = event.target.closest("[data-arch-subsystem]")
        if (subsystemButton) {
          state.subsystemID = subsystemButton.dataset.archSubsystem
          state.edgeID = ""
          render()
        }
      })

      let resizeFrame = 0
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeFrame)
        resizeFrame = requestAnimationFrame(() => render())
      })
      render()

      function selectDomain(domainID) {
        if (!domainById.has(domainID)) throw new Error(`architecture explorer: missing domain ${domainID}`)
        state.domainID = domainID
        state.componentID = ""
        state.subsystemID = ""
        state.edgeID = ""
        render()
      }

      function render() {
        renderViewControls()
        renderRail()
        renderPath()
        renderMap()
        renderEdges()
        renderLayerPanel()
        renderInspector()
        renderEvidence()
        requestAnimationFrame(() => drawLinks())
      }

      function renderViewControls() {
        els.viewControls.replaceChildren(
          ...viewModes.map((mode) => {
            const button = document.createElement("button")
            button.type = "button"
            button.className = "oc-arch-view-button"
            button.dataset.archView = mode.id
            button.setAttribute("aria-pressed", String(mode.id === state.view))
            button.textContent = text(mode.label)
            return button
          }),
        )
      }

      function renderRail() {
        els.rail.replaceChildren(
          ...domains.map((domain) => {
            const button = document.createElement("button")
            button.type = "button"
            button.className = "oc-arch-rail-button"
            button.dataset.archDomain = domain.id
            button.hidden = !domainVisible(domain)
            button.dataset.match = String(Boolean(state.query) && searchableText(domain).includes(state.query))
            button.setAttribute("aria-current", String(domain.id === state.domainID && !state.edgeID))
            button.append(strong(text(domain.title)))
            button.append(span(`${text(domain.lane)} · ${domain.components.length} ${locale === "zh" ? "组件" : "components"}`))
            return button
          }),
        )
      }

      function renderPath() {
        const domain = currentDomain()
        const parts = [text(labelFor("architecture")), text(domain.title)]
        const component = currentComponent()
        const subsystem = currentSubsystem()
        const edge = state.edgeID ? requiredEdge(state.edgeID) : undefined
        if (component) parts.push(text(component.title))
        if (subsystem) parts.push(text(subsystem.title))
        if (edge) parts.push(text(edge.label))
        els.path.replaceChildren(...parts.map((part, index) => {
          const item = document.createElement("span")
          item.textContent = index === 0 ? part : `› ${part}`
          return item
        }))
      }

      function renderMap() {
        els.map.replaceChildren(
          ...domains.map((domain) => {
            const button = document.createElement("button")
            button.type = "button"
            button.className = "oc-arch-node"
            button.dataset.archDomain = domain.id
            button.dataset.tone = domain.tone
            button.dataset.nodeId = domain.id
            button.dataset.match = String(Boolean(state.query) && searchableText(domain).includes(state.query))
            button.hidden = !domainVisible(domain)
            const position = positionFor(domain)
            button.style.gridColumn = String(position.col)
            button.style.gridRow = String(position.row)
            button.setAttribute("aria-pressed", String(domain.id === state.domainID && !state.edgeID))
            button.append(kicker(text(domain.lane)))
            button.append(div("oc-arch-node-title", text(domain.title)))
            button.append(div("oc-arch-node-meta", text(domain.summary)))
            button.append(div("oc-arch-node-count", `${domain.components.length} ${locale === "zh" ? "components" : "components"}`))
            return button
          }),
        )
      }

      function renderEdges() {
        const visible = visibleEdges()
        els.edgeStrip.replaceChildren(
          ...visible.map((edge) => {
            const from = requiredDomain(edge.from)
            const to = requiredDomain(edge.to)
            const button = document.createElement("button")
            button.type = "button"
            button.className = "oc-arch-edge-button"
            button.dataset.archEdge = edge.id
            button.setAttribute("aria-pressed", String(edge.id === state.edgeID))
            button.append(strong(text(edge.label)))
            button.append(span(`${text(from.title)} → ${text(to.title)}`))
            return button
          }),
        )
      }

      function renderLayerPanel() {
        const domain = currentDomain()
        const head = document.createElement("div")
        head.className = "oc-arch-layer-head"
        head.append(heading("h3", text(domain.title)))
        head.append(paragraph(text(domain.summary)))

        const componentGrid = document.createElement("div")
        componentGrid.className = "oc-arch-chip-grid"
        for (const component of domain.components) {
          if (!componentVisible(component, domain)) continue
          const chip = document.createElement("button")
          chip.type = "button"
          chip.className = "oc-arch-chip"
          chip.dataset.archComponent = component.id
          chip.dataset.match = String(Boolean(state.query) && searchableText(component).includes(state.query))
          chip.setAttribute("aria-pressed", String(component.id === state.componentID && !state.edgeID))
          chip.append(strong(text(component.title)))
          chip.append(span(text(component.summary)))
          componentGrid.append(chip)
        }

        const selectedComponent = currentComponent()
        const subpanel = document.createElement("div")
        subpanel.className = "oc-arch-subpanel"
        if (selectedComponent) {
          subpanel.append(heading("h3", text(selectedComponent.title)))
          subpanel.append(paragraph(text(selectedComponent.summary)))
          const subgrid = document.createElement("div")
          subgrid.className = "oc-arch-chip-grid"
          for (const subsystem of selectedComponent.subsystems) {
            const chip = document.createElement("button")
            chip.type = "button"
            chip.className = "oc-arch-chip"
            chip.dataset.archSubsystem = subsystem.id
            chip.dataset.match = String(Boolean(state.query) && searchableText(subsystem).includes(state.query))
            chip.setAttribute("aria-pressed", String(subsystem.id === state.subsystemID && !state.edgeID))
            chip.append(strong(text(subsystem.title)))
            chip.append(span(text(subsystem.summary)))
            subgrid.append(chip)
          }
          subpanel.append(subgrid)
        } else {
          subpanel.append(heading("h3", locale === "zh" ? "第二层：组件职责" : "Layer 2: component responsibilities"))
          subpanel.append(paragraph(locale === "zh" ? "选择上方组件以展开第三层细节。" : "Select a component above to open third-layer detail."))
        }

        els.layerPanel.replaceChildren(head, componentGrid, subpanel)
      }

      function renderInspector() {
        const edge = state.edgeID ? requiredEdge(state.edgeID) : undefined
        if (edge) {
          const from = requiredDomain(edge.from)
          const to = requiredDomain(edge.to)
          els.inspector.replaceChildren(
            heading("h3", text(edge.label)),
            paragraph(`${text(from.title)} → ${text(to.title)}`),
            sectionBlock(locale === "zh" ? "关系证据" : "Relationship evidence", edge.sources.map((source) => codeLine(source))),
            sectionBlock(locale === "zh" ? "运行语义" : "Runtime meaning", [
              text({ en: "This edge is a current runtime relationship, not a decorative connector.", zh: "这条边是当前运行关系，不是装饰连线。" }),
              text({ en: "The source paths listed below are the audit trail for the relationship.", zh: "下方 source path 是该关系的审计线索。" }),
            ]),
          )
          return
        }

        const domain = currentDomain()
        const component = currentComponent()
        const subsystem = currentSubsystem()
        const target = subsystem || component || domain
        const responsibilities = target.details || domain.constraints
        const sources = target.sources || domain.sources

        els.inspector.replaceChildren(
          heading("h3", text(target.title)),
          paragraph(text(target.summary)),
          sectionBlock(locale === "zh" ? "职责与边界" : "Responsibilities and boundaries", responsibilities.map((item) => text(item))),
          sectionBlock(locale === "zh" ? "当前证据路径" : "Current source paths", sources.map((source) => codeLine(source))),
          sectionBlock(locale === "zh" ? "架构约束" : "Architecture constraints", domain.constraints.map((item) => text(item))),
        )
      }

      function renderEvidence() {
        const domain = currentDomain()
        const component = currentComponent()
        const subsystem = currentSubsystem()
        const edge = state.edgeID ? requiredEdge(state.edgeID) : undefined
        const sources = edge
          ? edge.sources
          : subsystem
            ? subsystem.sources
            : component
              ? component.sources
              : domain.sources
        const related = visibleEdges().filter((edgeItem) => edgeItem.from === domain.id || edgeItem.to === domain.id)

        const title = heading("h3", locale === "zh" ? "证据抽屉" : "Evidence drawer")
        const intro = paragraph(locale === "zh" ? "当前选择的源码、方案与运行关系证据。" : "Source, spec, and runtime relationship evidence for the current selection.")
        const grid = document.createElement("div")
        grid.className = "oc-arch-evidence-grid"
        grid.append(evidenceCard(locale === "zh" ? "Source paths" : "Source paths", sources.map((source) => codeLine(source))))
        grid.append(evidenceCard(locale === "zh" ? "Related edges" : "Related edges", related.map((edgeItem) => `${text(requiredDomain(edgeItem.from).title)} → ${text(requiredDomain(edgeItem.to).title)}: ${text(edgeItem.label)}`)))
        grid.append(evidenceCard(locale === "zh" ? "Review guards" : "Review guards", [
          locale === "zh" ? "只表达 current new-arch 与当前源码事实。" : "Only current new-arch and current source facts are represented.",
          locale === "zh" ? "旧 planner/deliver/evaluation table 叙事不进入此图。" : "Retired planner/deliver/evaluation-table narratives are excluded.",
        ]))
        els.evidence.replaceChildren(title, intro, grid)
      }

      function drawLinks() {
        const rect = els.canvas.getBoundingClientRect()
        const visible = visibleEdges()
        const paths = []
        els.links.setAttribute("viewBox", `0 0 ${Math.max(rect.width, 860)} ${Math.max(rect.height, 410)}`)
        for (const edge of visible) {
          const fromNode = els.map.querySelector(`[data-node-id="${edge.from}"]`)
          const toNode = els.map.querySelector(`[data-node-id="${edge.to}"]`)
          if (!fromNode || !toNode || fromNode.hidden || toNode.hidden) continue
          const fromRect = fromNode.getBoundingClientRect()
          const toRect = toNode.getBoundingClientRect()
          const x1 = fromRect.left + fromRect.width / 2 - rect.left
          const y1 = fromRect.top + fromRect.height / 2 - rect.top
          const x2 = toRect.left + toRect.width / 2 - rect.left
          const y2 = toRect.top + toRect.height / 2 - rect.top
          const curve = Math.max(44, Math.abs(x2 - x1) * 0.36)
          const path = document.createElementNS("http://www.w3.org/2000/svg", "path")
          path.setAttribute("d", `M ${x1} ${y1} C ${x1 + curve} ${y1}, ${x2 - curve} ${y2}, ${x2} ${y2}`)
          path.dataset.archEdgePath = edge.id
          if (edge.id === state.edgeID) {
            path.style.strokeWidth = "3"
            path.style.opacity = "1"
          }
          paths.push(path)
        }
        els.links.replaceChildren(...paths)
      }

      function positionFor(domain) {
        if (els.canvas.getBoundingClientRect().width < 900) {
          const position = compactPositions[domain.id]
          if (!position) throw new Error(`architecture explorer: missing compact position for ${domain.id}`)
          return position
        }
        return domain.position
      }

      function ensureVisibleSelection() {
        const domain = domainById.get(state.domainID)
        if (domain && domainVisible(domain)) return
        const nextDomain = domains.find((item) => domainVisible(item))
        if (!nextDomain) return
        state.domainID = nextDomain.id
        state.componentID = ""
        state.subsystemID = ""
      }

      function domainVisible(domain) {
        const inView = domain.views.includes(state.view) || state.view === "overview"
        if (!inView) return false
        if (!state.query) return true
        return searchableText(domain).includes(state.query)
      }

      function componentVisible(component, domain) {
        if (!state.query) return true
        return searchableText(domain).includes(state.query) || searchableText(component).includes(state.query)
      }

      function visibleEdges() {
        return edges.filter((edge) => edge.views.includes(state.view) || state.view === "overview").filter((edge) => {
          const from = requiredDomain(edge.from)
          const to = requiredDomain(edge.to)
          return domainVisible(from) && domainVisible(to)
        })
      }

      function searchableText(item) {
        const values = []
        collectSearch(item, values)
        return values.join(" ").toLowerCase()
      }

      function collectSearch(value, values) {
        if (typeof value === "string") {
          values.push(value)
          return
        }
        if (!value || typeof value !== "object") return
        if (Array.isArray(value)) {
          for (const item of value) collectSearch(item, values)
          return
        }
        for (const item of Object.values(value)) collectSearch(item, values)
      }

      function currentDomain() {
        return requiredDomain(state.domainID)
      }

      function currentComponent() {
        if (!state.componentID) return undefined
        const component = currentDomain().components.find((item) => item.id === state.componentID)
        if (!component) throw new Error(`architecture explorer: missing component ${state.componentID}`)
        return component
      }

      function currentSubsystem() {
        const component = currentComponent()
        if (!component || !state.subsystemID) return undefined
        const subsystem = component.subsystems.find((item) => item.id === state.subsystemID)
        if (!subsystem) throw new Error(`architecture explorer: missing subsystem ${state.subsystemID}`)
        return subsystem
      }

      function requiredDomain(id) {
        const domain = domainById.get(id)
        if (!domain) throw new Error(`architecture explorer: missing domain ${id}`)
        return domain
      }

      function requiredEdge(id) {
        const edge = edgeById.get(id)
        if (!edge) throw new Error(`architecture explorer: missing edge ${id}`)
        return edge
      }

      function text(value) {
        const result = value[locale]
        if (typeof result !== "string") throw new Error(`architecture explorer: missing localized text for ${locale}`)
        return result
      }

      function labelFor(key) {
        const labels = {
          architecture: { en: "Architecture", zh: "架构" },
        }
        const label = labels[key]
        if (!label) throw new Error(`architecture explorer: missing label ${key}`)
        return label
      }
    }

    function must(value, name) {
      if (!value) throw new Error(`architecture explorer: missing ${name}`)
      return value
    }

    function heading(tag, value) {
      const node = document.createElement(tag)
      node.textContent = value
      return node
    }

    function paragraph(value) {
      const node = document.createElement("p")
      node.textContent = value
      return node
    }

    function strong(value) {
      const node = document.createElement("strong")
      node.textContent = value
      return node
    }

    function span(value) {
      const node = document.createElement("span")
      node.textContent = value
      return node
    }

    function div(className, value) {
      const node = document.createElement("div")
      node.className = className
      node.textContent = value
      return node
    }

    function kicker(value) {
      const node = document.createElement("span")
      node.className = "oc-arch-node-kicker"
      node.textContent = value
      return node
    }

    function sectionBlock(title, items) {
      const section = document.createElement("section")
      section.className = "oc-arch-inspector-section"
      section.append(heading("h4", title))
      const list = document.createElement("ul")
      for (const item of items) {
        const li = document.createElement("li")
        if (item instanceof Node) {
          li.append(item)
        } else {
          li.textContent = item
        }
        list.append(li)
      }
      section.append(list)
      return section
    }

    function evidenceCard(title, items) {
      const card = document.createElement("div")
      card.className = "oc-arch-evidence-card"
      card.append(strong(title))
      const list = document.createElement("ul")
      for (const item of items) {
        const li = document.createElement("li")
        if (item instanceof Node) {
          li.append(item)
        } else {
          li.textContent = item
        }
        list.append(li)
      }
      card.append(list)
      return card
    }

    function codeLine(value) {
      const node = document.createElement("code")
      node.textContent = value
      return node
    }
  })()
</script>
