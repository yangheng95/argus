    ],
    "urls": []
  },
  // ═══════════════════════════════════════════════════════════════════
  // Orchestrator 流水线配置
  // 控制 spec → planner → evaluator → delivery 四个 agent 阶段的行为
  // 所有值均为可选，未设置时使用括号中标注的默认值
  // ═══════════════════════════════════════════════════════════════════
  "orchestrator": {

    // ── Spec Agent ─────────────────────────────────────────────────
    // 将用户请求展开为精确的、基于代码探索的需求规格
    "spec": {
      // 单次 spec 生成允许的最大 agentic 步数（tool call 轮次）
      // 值越大，agent 可以做更深入的代码探索，但耗时更长
      // (默认: 30)
      "max_steps": 30,

      // spec 生成的超时时间（毫秒）
      // 包含所有 tool call + LLM 推理时间
      // (默认: 300000 = 5 分钟)
      "timeout_ms": 300000,

      // 产出 spec 前要求的最少 tool call 次数
      // 低于此数的 spec 被视为"未充分探索"，质量扣分
      // 设为 0 可跳过探索要求（不推荐）
      // (默认: 3)
      "min_tool_calls": 3,

      // 质量评分阈值 (0.0 ~ 1.0)
      // spec 输出低于此分数会自动重试
      // 评分维度: tool call 深度(0.2) + 内容长度(0.25) + spec items(0.3) + 证据来源(0.1) + 文件路径(0.15)
      // (默认: 0.6)
      "quality_threshold": 0.6,

      // 最大重试次数
      // 第一次不算重试，所以 max_attempts=3 表示最多重试 2 次
      // 最后一次无论分数多低都会返回结果
      // (默认: 3)
      "max_attempts": 3
    },

    // ── Planner Agent ──────────────────────────────────────────────
    // 基于 spec 产出 PRD / goals / subtasks / risks 的实施计划
    "planner": {
      // 单次 plan 生成允许的最大 agentic 步数
      // (默认: 30)
      "max_steps": 30,

      // plan 生成的超时时间（毫秒）
      // (默认: 300000 = 5 分钟)
      "timeout_ms": 300000,

      // 产出 plan 前要求的最少 tool call 次数
      // (默认: 3)
      "min_tool_calls": 3,

      // 质量评分阈值 (0.0 ~ 1.0)
      // 评分维度: tool call(0.3) + 新发现文件路径(0.25) + goal 具体度(0.2) + subtask 路径(0.15) + PRD 长度(0.1)
      // (默认: 0.5)
      "quality_threshold": 0.5,

      // 最大重试次数
      // (默认: 3)
      "max_attempts": 3
    },

    // ── Evaluator Agent ────────────────────────────────────────────
    // 执行后验证 goal 是否达成，判定 pass/fail 并做失败分析
    "evaluator": {
      // 单次评估允许的最大 agentic 步数
      // (默认: 25)
      "max_steps": 25,

      // 评估超时时间（毫秒）
      // (默认: 240000 = 4 分钟)
      "timeout_ms": 240000,

      // 最少 tool call 次数（用于验证代码变更）
      // (默认: 3)
      "min_tool_calls": 3
    },

    // ── Delivery Agent ─────────────────────────────────────────────
    // 端到端交付验证和 bug 修复
    "delivery": {
      // 单次交付验证允许的最大 agentic 步数（所有 agent 中最高）
      // (默认: 40)
      "max_steps": 40,

      // 交付 agent 超时时间（毫秒）
      // 也可通过环境变量 OPENCORVUS_DELIVERY_AGENT_TIMEOUT_MS 覆盖（最高优先级）
      // (默认: 600000 = 10 分钟)
      "timeout_ms": 600000,

      // 交付 agent 内部的最大生成重试次数
      // (默认: 2)
      "max_retries": 2,

      // 最少 tool call 次数
      // (默认: 3)
      "min_tool_calls": 3
    },

    // ── 全局编排限制 ───────────────────────────────────────────────

    // 单个任务的最大总运行次数
    // 包含所有 retry + replan 产生的 run
    // 超过后任务直接标记失败
    // 也可通过环境变量 OPENCORVUS_MAX_RUNS 覆盖
    // (默认: 10)
    "max_runs": 10,

    // 最大重新规划次数
    // 当 evaluator 判定为 strategy 类失败时触发 replan
    // 也可通过环境变量 OPENCORVUS_MAX_REPLANS 覆盖
    // (默认: 3)
    "max_replans": 3,

    // 同一计划下的最大重试次数
    // 超过后会触发 replan 而非继续 retry
    // 也可通过环境变量 OPENCORVUS_SAME_PLAN_RETRY_LIMIT 覆盖
    // (默认: 2)
    "same_plan_retry_limit": 2,

    // 每个编排阶段（spec/plan/evaluate/deliver）的最大内部重试次数
    // agent 抛异常时 withStageRetry 会重试，不含首次执行
    // (默认: 2)
    "stage_max_retries": 2
  },

  "permission": {
