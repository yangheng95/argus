                    const resolvedInput = echo.ok ? echo.value : match.state.input
                    await Session.updatePart({
                      ...match,
                      state: {
                        status: "error",
                        input: resolvedInput,
                        error: (value.error as any).toString(),
                        time: {
                          start: match.state.time.start,
                          end: Date.now(),
                        },
