<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>百度一下，你就知道</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: "Microsoft YaHei", sans-serif; background: #fff; color: #222; }
.nav { display: flex; align-items: center; justify-content: space-between; height: 60px; padding: 0 24px; }
.nav-left { display: flex; gap: 24px; }
.nav-link { font-size: 13px; color: #333; text-decoration: none; }
.nav-login-btn { font-size: 13px; color: #fff; background: #4e6ef2; border: none; border-radius: 6px; padding: 6px 16px; cursor: pointer; }
.main { display: flex; flex-direction: column; align-items: center; padding-top: 40px; gap: 24px; }
.logo-container { margin-bottom: 8px; }
.logo { width: 270px; height: 100px; }
.search-area { position: relative; width: 100%; max-width: 750px; }
.search-wrapper { display: flex; align-items: center; height: 54px; background: #fff; border: 2px solid #c4c7ce; border-radius: 12px; }
.search-input { flex: 1; height: 100%; padding: 0 16px; font-size: 16px; border: none; outline: none; }
.search-input::placeholder { color: #b6b6b6; }
.search-tools { display: flex; align-items: center; gap: 8px; padding: 0 8px; }
.tool-btn { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; border: none; background: none; cursor: pointer; }
.search-button { height: 44px; padding: 0 24px; margin: 5px 5px 5px 0; font-size: 17px; font-weight: 500; color: #fff; background: linear-gradient(to right, #6e7dff, #3c60fa); border: none; border-radius: 10px; cursor: pointer; }
.ai-prompt { display: flex; align-items: center; gap: 8px; padding: 10px 24px; background: #f5f6f5; border-radius: 20px; cursor: pointer; }
.ai-text { font-size: 14px; color: #626675; }
.hot-search-section { width: 100%; max-width: 600px; padding: 0 16px; }
.hot-search-header { display: flex; align-items: center; justify-content: space-between; height: 30px; margin-bottom: 16px; }
.hot-search-title { font-size: 14px; font-weight: 700; color: #222; }
.refresh-btn { display: flex; align-items: center; gap: 4px; font-size: 13px; color: #9195a3; border: none; background: none; cursor: pointer; }
.hot-list-grid { display: flex; gap: 40px; }
.hot-list-col { flex: 1; display: flex; flex-direction: column; gap: 16px; }
.hot-item { display: flex; align-items: center; gap: 8px; height: 24px; cursor: pointer; }
.hot-rank { font-family: Arial, sans-serif; font-size: 16px; font-weight: 700; color: #9195a3; min-width: 20px; text-align: center; }
.hot-rank.rank-1 { color: #f54545; }
.hot-rank.rank-2 { color: #ff8547; }
.hot-rank.rank-3 { color: #ffac38; }
.hot-rank.rank-top { color: #f54545; font-size: 14px; }
.hot-text { font-size: 14px; color: #222; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }
.hot-tag { font-size: 10px; color: #fff; padding: 1px 4px; border-radius: 2px; }
.hot-tag.hot { background: #ff6633; }
.hot-tag.new { background: #ff3333; }
.footer { display: flex; align-items: center; justify-content: center; gap: 15px; height: 60px; padding: 0 24px; }
.footer-link { font-size: 12px; color: #999; text-decoration: none; white-space: nowrap; }
.footer-icon { display: flex; align-items: center; cursor: pointer; opacity: 0.6; }
</style>
</head>
<body>
