  symbol: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 600, fontSize: '16px', lineHeight: '22px' },
  navItem: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 500, fontSize: '14px', lineHeight: '20px' },
};

// Spacing
export const spacing = {
  headerHeight: '56px',
  sidebarWidth: '56px',
  rightPanelWidth: '320px',
  panelPadding: '16px',
  listGap: '8px',
  sectionGap: '24px',
  iconMargin: '12px',
  buttonPaddingX: '16px',
  tabGap: '24px',
  inputHeight: '40px',
};
