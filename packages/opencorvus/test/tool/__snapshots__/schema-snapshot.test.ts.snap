  "goal_report": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "blockers": {
        "default": [],
        "description": "Hard blockers hit during execution. Empty when none. A filled array signals the goal did not fully complete.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "checks_run": {
        "default": [],
        "description": "Commands executed to verify the goal (build / test / lint / verify). Empty array is allowed only for goals whose acceptance is entirely rubric/semantic.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "command": {
              "minLength": 1,
              "type": "string",
            },
            "exit_code": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            "name": {
              "minLength": 1,
              "type": "string",
            },
            "output_excerpt": {
              "description": "Last relevant lines of stdout/stderr (≤ 2000 chars). Omit when trivially green.",
              "type": "string",
            },
          },
          "required": [
            "name",
            "command",
            "exit_code",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "design_decisions": {
        "default": [],
        "description": "Key decisions and why. Each entry names the alternatives considered and the reason the chosen one won. Empty array means the goal required no non-trivial decision.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "alternatives": {
              "default": [],
              "description": "Alternatives that were considered and rejected. Empty array if none were weighed.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "choice": {
              "description": "The decision made, stated as a concrete claim.",
              "minLength": 1,
              "type": "string",
            },
            "reason": {
              "description": "Why this choice won over the alternatives. Must be a real reason, not a restatement of the choice.",
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "choice",
            "alternatives",
            "reason",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "files_changed": {
        "description": "Every file touched in this goal. May be empty if the goal's acceptance was met by reusing a prior attempt's worktree without further edits — the orchestrator cross-checks against the host's actual_changed_files ground truth.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string",
            },
            "summary": {
              "description": "What changed in this file and why. One or two sentences, concrete — not 'updated foo'.",
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "path",
            "summary",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "followup_workload_guidance": {
        "description": "Explicit warning for subsequent agents about hidden or remaining work surface, evidence they must read deeper, and whether goal workload analysis or Architect re-sizing should be revisited.",
        "minLength": 1,
        "type": "string",
      },
      "implementation_approach": {
        "description": "The actual implementation plan: what scheme you used, core structure, key APIs, and data flow. Must describe the approach concretely so an evaluator can cross-check the diff against it.",
        "minLength": 40,
        "type": "string",
      },
    },
    "required": [
      "files_changed",
      "checks_run",
      "implementation_approach",
      "design_decisions",
      "blockers",
    ],
    "type": "object",
  },
