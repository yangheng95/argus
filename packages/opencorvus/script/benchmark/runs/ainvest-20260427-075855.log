// src/server/types.ts

export interface StockInfo {
  symbol: string;
  name: string;
  currentPrice: number;
  change: number;
  changePercent: number;
  marketCap: number;
  volume: number;
  high: number;
  low: number;
  open: number;
  prevClose: number;
}

export interface KLineData {
  time: number; // Unix timestamp
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

export interface IndicatorData {
  time: number;
  value: number;
}

export interface TechnicalIndicators {
  ma5: IndicatorData[];
  ma10: IndicatorData[];
  ma20: IndicatorData[];
  ma60: IndicatorData[];
}

export type Timeframe = '1d' | '1w' | '1m';
