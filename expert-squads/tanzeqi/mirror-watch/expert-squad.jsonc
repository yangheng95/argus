        "package_mcp_resource_refs": [],
      },
      "mirror-watch-report-analyst": {
        "label": "Mirror Watch Report Analyst",
        "description": "Validates the exact Task-selected cohort and creates the deterministic 3-2-1 report through the package tool.",
        "base_role": "delegated-worker",
        "prompt": "agents/mirror-watch-report-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
