// src/server/types/stock.ts
export interface StockQuote {
  symbol: string;
  price: number;
  change: number;
  changePercent: number;
  exchange: string;
  name: string;
  logo?: string;
}

export interface OHLCData {
  time: number;
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

export interface TechnicalIndicators {
  symbol: string;
  ma: { period: number; value: number }[];
  rsi: number;
  macd: { macd: number; signal: number; histogram: number };
}

export interface WatchlistItem {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  iconColor: string;
}

export interface WatchlistData {
  myList: WatchlistItem[];
  myCrypto: WatchlistItem[];
}
