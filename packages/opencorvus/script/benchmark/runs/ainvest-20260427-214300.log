```ts
// src/server/index.ts
import { Hono } from 'hono';
import { cors } from 'hono/cors';

const app = new Hono();

// GET /api/candles?symbol=NVDA&from=1704067200&to=1706745600&resolution=1D
app.get('/api/candles', (c) => {
  const symbol = c.req.query('symbol') || 'NVDA';
  const from = parseInt(c.req.query('from') || '0');
  const to = parseInt(c.req.query('to') || '0');
  const resolution = c.req.query('resolution') || '1D';
  return c.json({ candles: CandleData[] });
});

// GET /api/indicators?symbol=NVDA&type=ma|macd|volume
app.get('/api/indicators', (c) => {
  const symbol = c.req.query('symbol') || 'NVDA';
  const type = c.req.query('type') || 'ma';
  return c.json({ ma?: MAData, macd?: MACDData[], volume?: VolumeData[] });
});

// GET /api/orderbook?symbol=NVDA
app.get('/api/orderbook', (c) => {
  const symbol = c.req.query('symbol') || 'NVDA';
  return c.json({ orderbook: OrderBookData });
});

// GET /api/indices
app.get('/api/indices', (c) => {
  return c.json({ indices: MarketIndex[] });
});

// GET /api/stock/:symbol
app.get('/api/stock/:symbol', (c) => {
  const symbol = c.req.param('symbol');
  return c.json({ stock: StockInfo });
});

export default app;
