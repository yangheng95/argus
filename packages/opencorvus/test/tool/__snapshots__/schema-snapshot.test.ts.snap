                              "contains",
                              "exact_match",
                              "length_within",
                              "json_schema",
                              "visual-evidence-bundle",
                            ],
                            "type": "string",
                          },
                          "spec": {
                            "additionalProperties": false,
                            "description": "For name=visual-evidence-bundle, identifies the required visual evidence bundle shape.",
                            "properties": {
                              "kind": {
                                "const": "visual_evidence_bundle",
                                "type": "string",
                              },
                              "viewport": {
                                "minLength": 1,
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                            ],
                            "type": "object",
                          },
                          "type": {
                            "const": "prebuilt",
                            "description": "prebuilt — a named library metric. Requires: name from the fixed PREBUILT_SCORER_NAMES set; optional config.",
                            "type": "string",
                          },
                        },
                        "required": [
                          "type",
                          "name",
                          "config",
                        ],
                        "type": "object",
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "expect": {
                            "additionalProperties": false,
                            "properties": {
                              "status": {
                                "const": "passed",
                                "type": "string",
                              },
                            },
                            "required": [
                              "status",
                            ],
                            "type": "object",
                          },
                          "name": {
                            "minLength": 1,
                            "type": "string",
                          },
                          "spec": {
                            "additionalProperties": false,
                            "properties": {
                              "contract_ids": {
                                "items": {
                                  "minLength": 1,
                                  "type": "string",
                                },
                                "minItems": 1,
                                "type": "array",
                              },
                              "kind": {
                                "const": "contract_graph",
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "contract_ids",
                            ],
                            "type": "object",
                          },
                          "type": {
                            "const": "contract_audit",
                            "description": "contract_audit — static audit of typed-contract field literals against registered graph contract_ids. This is a scorer type, not a script_ref path. Requires: name, spec.contract_ids, expect.status='passed'.",
                            "type": "string",
                          },
                        },
                        "required": [
                          "type",
                          "name",
                          "spec",
                          "expect",
                        ],
                        "type": "object",
                      },
                    ],
                  },
                  "minItems": 1,
                  "type": "array",
                },
                "severity": {
                  "enum": [
                    "essential",
                    "important",
                    "optional",
                    "pitfall",
                  ],
                  "type": "string",
                },
                "source_requirement_id": {
                  "description": "Requirement ID this spec was derived from (REQ-N).",
                  "minLength": 1,
                  "type": "string",
                },
                "title": {
                  "minLength": 1,
                  "type": "string",
                },
                "trigger": {
                  "description": "Override default trigger. Defaults: heuristic/prebuilt=on_goal; llm_judge essential=on_goal; other=on_integrity.",
                  "enum": [
                    "on_goal",
                    "on_integrity",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "id",
                "source_requirement_id",
                "goal_id",
                "title",
                "scorers",
                "severity",
              ],
              "type": "object",
            },
            "minItems": 1,
            "type": "array",
          },
          "action": {
            "const": "update_goal",
            "type": "string",
          },
          "description": {
            "description": "Replacement goal description.",
            "type": "string",
          },
          "goalID": {
            "description": "Goal ID to update.",
            "type": "string",
          },
        },
        "required": [
          "action",
          "goalID",
          "description",
          "acceptance_specs",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "delete_goal",
            "type": "string",
          },
          "goalID": {
            "description": "Goal ID to delete.",
            "type": "string",
          },
        },
        "required": [
          "action",
          "goalID",
        ],
        "type": "object",
      },
    ],
  },
  "planner": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "add_task",
            "type": "string",
          },
          "goal": {
            "description": "What this task should accomplish",
            "type": "string",
          },
          "parentId": {
            "description": "Parent task ID for subtasks",
            "type": "string",
          },
          "priority": {
            "description": "Priority 0-10 (higher = more important)",
            "maximum": 10,
            "minimum": 0,
            "type": "integer",
          },
        },
        "required": [
          "action",
          "goal",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "update_task",
            "type": "string",
          },
          "notes": {
            "description": "Update task notes",
            "type": "string",
          },
          "progressPct": {
            "description": "Progress percentage 0-100",
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
          },
          "status": {
            "description": "Lifecycle state to assign to the task after this update.",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked",
              "cancelled",
            ],
            "type": "string",
          },
          "taskId": {
            "description": "Task ID to update",
            "type": "string",
          },
        },
        "required": [
          "action",
          "taskId",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "list_tasks",
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "scratchpad_write",
            "type": "string",
          },
          "content": {
            "description": "Content to write (replaces existing)",
            "type": "string",
          },
        },
        "required": [
          "action",
          "content",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "scratchpad_append",
            "type": "string",
          },
          "content": {
            "description": "Content to append",
            "type": "string",
          },
        },
        "required": [
          "action",
          "content",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "scratchpad_read",
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
    ],
  },
  "read": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "filePath": {
        "description": "The absolute path to the file or directory to read",
        "type": "string",
      },
      "limit": {
        "description": "The maximum number of lines to read (defaults to 2000)",
        "type": "number",
      },
      "offset": {
        "description": "The line number to start reading from (1-indexed)",
        "type": "number",
      },
    },
    "required": [
      "filePath",
    ],
    "type": "object",
  },
  "schedule": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "create",
            "type": "string",
          },
          "name": {
            "description": "Short name for the task",
            "type": "string",
          },
          "oneShot": {
            "description": "Execute once (default: true for intervals, false for cron)",
            "type": "boolean",
          },
          "prompt": {
            "description": "The instruction to execute when triggered",
            "type": "string",
          },
          "schedule": {
            "description": "Cron expression ('0 9 * * *') or interval ('30m', '2h', '1d')",
            "type": "string",
          },
        },
        "required": [
          "action",
          "name",
          "schedule",
          "prompt",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "list",
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "cancel",
            "type": "string",
          },
          "jobId": {
            "description": "The ID of the scheduled task to cancel",
            "type": "string",
          },
        },
        "required": [
          "action",
          "jobId",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "create_event",
            "type": "string",
          },
          "cooldownMs": {
            "description": "Minimum ms between runs for this job",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "eventType": {
            "description": "Bus event type wildcard (for example: 'command.*' or 'session.updated')",
            "type": "string",
          },
          "match": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "number",
                },
                {
                  "type": "boolean",
                },
              ],
            },
            "description": "Optional event property matcher, e.g. {'properties.name':'init'}",
            "propertyNames": {
              "type": "string",
            },
            "type": "object",
          },
          "name": {
            "description": "Short name for the event task",
            "type": "string",
          },
          "oneShot": {
            "default": false,
            "description": "Execute only once",
            "type": "boolean",
          },
          "prompt": {
            "description": "The instruction to execute when the event matches",
            "type": "string",
          },
        },
        "required": [
          "action",
          "name",
          "eventType",
          "prompt",
          "oneShot",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "list_event",
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "cancel_event",
            "type": "string",
          },
          "jobId": {
            "description": "The ID of the event task to cancel",
            "type": "string",
          },
        },
        "required": [
          "action",
          "jobId",
        ],
        "type": "object",
      },
    ],
  },
  "search_code": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "include": {
        "description": "File pattern to include in the search (e.g. "*.js", "*.{ts,tsx}")",
        "type": "string",
      },
      "path": {
        "description": "The directory to search in. Defaults to the current working directory.",
        "type": "string",
      },
      "pattern": {
        "description": "Required regex pattern to search for in file contents. This field is named "pattern"; do not use "query".",
        "type": "string",
      },
    },
    "required": [
      "pattern",
    ],
    "type": "object",
  },
  "skill": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "Exact skill name to load. Omit name to search/list skills instead of loading full instructions.",
        "type": "string",
      },
      "query": {
        "description": "Fuzzy search terms for mounted skill title, description, required_tools, agents, or SKILL.md content. Omit to list compatible skills.",
        "type": "string",
      },
    },
    "type": "object",
  },
  "task": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "command": {
        "description": "The command that triggered this task",
        "type": "string",
      },
      "description": {
        "description": "A short (3-5 words) description of the task",
        "type": "string",
      },
      "prompt": {
        "description": "The task for the agent to perform",
        "type": "string",
      },
      "subagent_type": {
        "description": "The type of specialized agent to use for this task",
        "type": "string",
      },
      "task_id": {
        "description": "This should only be set if you mean to resume a previous task (you can pass a prior task_id and the task will continue the same subagent session as before instead of creating a fresh one)",
        "type": "string",
      },
    },
    "required": [
      "description",
      "prompt",
      "subagent_type",
    ],
    "type": "object",
  },
  "task_report": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "artifacts": {
        "description": "Files created or modified (when status=done)",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "error": {
        "description": "Error details (when status=failed)",
        "type": "string",
      },
      "next_plan": {
        "description": "What to do in the next turn (when status=progress)",
        "type": "string",
      },
      "question": {
        "description": "Question for the user (required when status=need_input)",
        "type": "string",
      },
      "status": {
        "description": "progress=more turns needed | need_input=waiting for user | done=session turn complete | failed=session error",
        "enum": [
          "progress",
          "need_input",
          "done",
          "failed",
        ],
        "type": "string",
      },
      "summary": {
        "description": "What happened this turn, or the final result",
        "type": "string",
      },
    },
    "required": [
      "status",
      "summary",
    ],
    "type": "object",
  },
  "todoread": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {},
    "type": "object",
  },
  "todowrite": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "todos": {
        "description": "The updated todo list",
        "items": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "description": "Brief description of the task",
              "type": "string",
            },
            "priority": {
              "description": "Priority level of the task: high, medium, low",
              "type": "string",
            },
            "status": {
              "description": "Current status of the task: pending, in_progress, completed, cancelled",
              "type": "string",
            },
          },
          "required": [
            "content",
            "status",
            "priority",
          ],
          "type": "object",
        },
        "type": "array",
      },
    },
    "required": [
      "todos",
    ],
    "type": "object",
  },
  "webfetch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "format": {
        "default": "markdown",
        "description": "The format to return the content in (text, markdown, or html). Defaults to markdown.",
        "enum": [
          "text",
          "markdown",
          "html",
        ],
        "type": "string",
      },
      "timeout": {
        "description": "Optional timeout in seconds (max 120)",
        "type": "number",
      },
      "url": {
        "description": "The URL to fetch content from",
        "type": "string",
      },
    },
    "required": [
      "url",
      "format",
    ],
    "type": "object",
  },
  "websearch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "contextMaxCharacters": {
        "description": "Maximum characters for context string optimized for LLMs",
        "type": "number",
      },
      "livecrawl": {
        "default": "preferred",
        "description": "Live crawl mode. The tool always prioritizes live crawling for current web evidence.",
        "enum": [
          "preferred",
        ],
        "type": "string",
      },
      "numResults": {
        "description": "Number of search results to return",
        "type": "number",
      },
      "query": {
        "description": "Websearch query",
        "type": "string",
      },
      "type": {
        "description": "Search type - 'auto': balanced search, 'fast': quick results, 'deep': comprehensive search",
        "enum": [
          "auto",
          "fast",
          "deep",
        ],
        "type": "string",
      },
    },
    "required": [
      "query",
      "livecrawl",
    ],
    "type": "object",
  },
  "write": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "content": {
        "description": "The content to write to the file",
        "type": "string",
      },
      "filePath": {
        "description": "The absolute path to the file to write (must be absolute, not relative)",
        "type": "string",
      },
    },
    "required": [
      "content",
      "filePath",
    ],
    "type": "object",
  },
}
`;
