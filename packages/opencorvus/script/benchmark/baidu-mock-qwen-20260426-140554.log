/* ============================================
   Baidu Homepage Clone - Styles
   Design tokens from mirror/design-tokens.ts
   ============================================ */

/* Reset */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
  background: #ffffff;
  color: #222222;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  border: none;
  background: none;
  cursor: pointer;
  font-family: inherit;
}

/* ============================================
   Navigation Bar
   ============================================ */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
  padding: 0 24px;
  background: #ffffff;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-link {
  font-size: 13px;
  font-weight: 400;
  color: #333333;
  white-space: nowrap;
  padding: 4px 0;
  transition: color 0.2s;
}

.nav-link:hover {
  color: #4e6ef2;
}

.nav-login-btn {
  font-size: 13px;
  font-weight: 500;
  color: #ffffff;
  background: #4e6ef2;
  border-radius: 6px;
  padding: 6px 16px;
  transition: background 0.2s;
}

.nav-login-btn:hover {
  background: #3c60fa;
}

/* ============================================
   Main Content
   ============================================ */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40px;
  gap: 24px;
}

/* ============================================
   Logo
   ============================================ */
.logo-container {
  display: flex;
  justify-content: center;
  margin-bottom: 8px;
}

.logo {
  width: 250px;
  height: 120px;
}

/* ============================================
   Search Area
   ============================================ */
.search-area {
  position: relative;
  width: 100%;
  max-width: 750px;
}

.search-wrapper {
  display: flex;
  align-items: center;
  height: 54px;
  background: #ffffff;
  border: 2px solid #c4c7ce;
  border-radius: 12px;
  overflow: visible;
  transition: border-color 0.2s;
}

.search-wrapper:focus-within {
  border-color: #4e6ef2;
}

.search-input {
  flex: 1;
  height: 100%;
  padding: 0 16px;
  font-size: 16px;
  font-family: "Microsoft YaHei", sans-serif;
  color: #222222;
  border: none;
  outline: none;
  background: transparent;
}

.search-input::placeholder {
  color: #b6b6b6;
}

.search-tools {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 8px;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  transition: background 0.2s;
}

.tool-btn:hover {
  background: #f5f6f5;
}

.search-button {
  height: 44px;
  padding: 0 24px;
  margin: 5px 5px 5px 0;
  font-size: 17px;
  font-weight: 500;
  font-family: "Microsoft YaHei", sans-serif;
  color: #ffffff;
  background: linear-gradient(to right, #6e7dff, #3c60fa);
  border-radius: 10px;
  white-space: nowrap;
  transition: opacity 0.2s;
}

.search-button:hover {
  opacity: 0.9;
}

/* Search suggestions dropdown */
.suggestions-dropdown {
  position: absolute;
  top: 56px;
  left: 0;
  right: 0;
  background: #ffffff;
  border: 1px solid #c4c7ce;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  display: none;
  z-index: 100;
}

.suggestions-dropdown.active {
  display: block;
}

.suggestion-item {
  padding: 10px 16px;
  font-size: 14px;
  color: #222222;
  cursor: pointer;
  transition: background 0.15s;
}

.suggestion-item:hover {
  background: #f5f6f5;
}

.suggestion-item:last-child {
  border-radius: 0 0 8px 8px;
}

/* ============================================
   AI Assistant Prompt
   ============================================ */
.ai-prompt {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  background: #f5f6f5;
  border-radius: 20px;
  cursor: pointer;
  transition: background 0.2s;
}

.ai-prompt:hover {
  background: #e8e9e8;
}

.ai-icon {
  display: flex;
  align-items: center;
}

.ai-text {
  font-size: 14px;
  font-weight: 400;
  color: #626675;
}

/* ============================================
   Hot Search Section
   ============================================ */
.hot-search-section {
  width: 100%;
  max-width: 600px;
  padding: 0 16px;
}

.hot-search-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 30px;
  margin-bottom: 16px;
}

.hot-search-title {
  font-size: 14px;
  font-weight: 700;
  color: #222222;
  cursor: pointer;
}

.hot-search-title:hover {
  color: #4e6ef2;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: #9195a3;
  transition: color 0.2s;
}

.refresh-btn:hover {
  color: #4e6ef2;
}

.hot-list-grid {
  display: flex;
  gap: 40px;
}

.hot-list-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hot-item {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 24px;
  cursor: pointer;
  transition: opacity 0.15s;
}

.hot-item:hover {
  opacity: 0.7;
}

.hot-rank {
  font-family: Arial, sans-serif;
  font-size: 16px;
  font-weight: 700;
  color: #9195a3;
  min-width: 20px;
  text-align: center;
}

.hot-rank.rank-1 {
  color: #f54545;
}

.hot-rank.rank-2 {
  color: #ff8547;
}

.hot-rank.rank-3 {
  color: #ffac38;
}

.hot-rank.rank-top {
  color: #f54545;
  font-size: 14px;
}

.hot-text {
  font-size: 14px;
  font-weight: 400;
  color: #222222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.hot-tag {
  font-size: 10px;
  font-weight: 400;
  color: #ffffff;
  padding: 1px 4px;
  border-radius: 2px;
  white-space: nowrap;
}

.hot-tag.hot {
  background: #ff6633;
}

.hot-tag.new {
  background: #ff3333;
}

/* ============================================
   Footer
   ============================================ */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  height: 60px;
  padding: 0 24px;
  background: #ffffff;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 12px;
  font-weight: 400;
  color: #999999;
  white-space: nowrap;
  transition: color 0.2s;
}

.footer-link:hover {
  color: #4e6ef2;
}

.footer-icon {
  display: flex;
  align-items: center;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.footer-icon:hover {
  opacity: 1;
}

/* ============================================
   Toast Notification
   ============================================ */
.toast {
  position: fixed;
  top: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(-20px);
  padding: 12px 24px;
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  font-size: 14px;
  border-radius: 8px;
  opacity: 0;
  transition: opacity 0.3s, transform 0.3s;
  pointer-events: none;
  z-index: 1000;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ============================================
   Responsive adjustments
   ============================================ */
@media (max-width: 768px) {
  .nav-left {
    gap: 12px;
  }

  .nav-link {
    font-size: 12px;
  }

  .search-area {
    max-width: 90%;
  }

  .hot-list-grid {
    flex-direction: column;
    gap: 16px;
  }

  .footer {
    gap: 8px;
    height: auto;
    padding: 16px;
  }
}
