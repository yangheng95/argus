# ============================================================
# OpenCorvus Channel Runtime environment example
# Copy to .env, fill in values, then run bun dev
# ============================================================

# ---- DashScope API Key（选其一）----
# sk-sp-* 前缀 → Coding Plan endpoint (DASHSCOPE_CODING_BASE_URL)
# sk-*    前缀 → 标准 intl endpoint (DASHSCOPE_INTL_BASE_URL)
CODING_DASHSCOPE_API_KEY=sk-sp-...
# DASHSCOPE_API_KEY=sk-...

# ---- DashScope Endpoint URL（按 key 前缀自动路由）----
DASHSCOPE_CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/api/v1
DASHSCOPE_INTL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---- LLM 默认模型（无交互提示时使用）----
OPENCORVUS_DEFAULT_MODEL=alibaba-cn/qwen3.5-plus

# ---- 各 Provider 交互提示的默认模型（可选）----
OPENCORVUS_MODEL_ALIBABA=alibaba-cn/qwen3.5-plus
# OPENCORVUS_MODEL_ANTHROPIC=anthropic/claude-sonnet-4-6
# OPENCORVUS_MODEL_OPENAI=openai/gpt-4o
# OPENCORVUS_MODEL_GOOGLE=google/gemini-2.5-pro
# OPENCORVUS_MODEL_DEEPSEEK=deepseek/deepseek-chat
# OPENCORVUS_MODEL_OPENROUTER=openrouter/anthropic/claude-sonnet-4

# ---- Vision 模型（使用 DashScope API Key）----
OPENCORVUS_VISION_MODEL=qwen3.5-plus

# ---- 其他 LLM Provider API Key（可选）----
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=...

# ---- Slack 适配器（与 Telegram 二选一，或同时配置）----
# Slack App 需开启 Socket Mode，并订阅 message.channels / message.im 事件
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
# Optional allowlist for user-level controls (comma-separated user IDs)
# SLACK_ALLOWED_USER_IDS=U01234567,U09876543

# ---- Telegram 适配器（可选）----
# TELEGRAM_BOT_TOKEN=...

# ---- Discord 适配器（可选）----
# DISCORD_BOT_TOKEN=...

# ---- Feishu channel (text MVP) ----
# FEISHU_APP_ID=cli_...
# FEISHU_APP_SECRET=...
# FEISHU_WEBHOOK_HOST=0.0.0.0
# FEISHU_WEBHOOK_PORT=16666
# FEISHU_WEBHOOK_PATH=/feishu
# FEISHU_VERIFICATION_TOKEN=...

# ---- Additional mainstream channels ----
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_APP_SECRET=...
# WHATSAPP_VERIFY_TOKEN=...
# WHATSAPP_WEBHOOK_HOST=0.0.0.0
# WHATSAPP_WEBHOOK_PORT=16667
# WHATSAPP_WEBHOOK_PATH=/whatsapp

# GOOGLECHAT_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLECHAT_AUTH_AUDIENCE=https://public.opencorvus.dev/googlechat
# GOOGLECHAT_WEBHOOK_HOST=0.0.0.0
# GOOGLECHAT_WEBHOOK_PORT=16668
# GOOGLECHAT_WEBHOOK_PATH=/googlechat

# MSTEAMS_APP_ID=...
# MSTEAMS_APP_SECRET=...
# MSTEAMS_WEBHOOK_HOST=0.0.0.0
# MSTEAMS_WEBHOOK_PORT=16669
# MSTEAMS_WEBHOOK_PATH=/msteams

# LINE_CHANNEL_ACCESS_TOKEN=...
# LINE_CHANNEL_SECRET=...
# LINE_WEBHOOK_HOST=0.0.0.0
# LINE_WEBHOOK_PORT=16670
# LINE_WEBHOOK_PATH=/line

# MATRIX_HOMESERVER_URL=https://matrix.example.com
# MATRIX_ACCESS_TOKEN=...
# MATRIX_SINCE_TOKEN=...

# MATTERMOST_SERVER_URL=https://mattermost.example.com
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_WEBHOOK_TOKEN=...
# MATTERMOST_WEBHOOK_HOST=0.0.0.0
# MATTERMOST_WEBHOOK_PORT=16671
# MATTERMOST_WEBHOOK_PATH=/mattermost

# SIGNAL_SERVICE_URL=http://127.0.0.1:8080
# SIGNAL_ACCOUNT=+15551234567

# WECOM_CORP_ID=...
# WECOM_SECRET=...
# WECOM_AGENT_ID=...
# WECOM_CALLBACK_TOKEN=...
# WECOM_ENCODING_AES_KEY=...
# WECOM_WEBHOOK_HOST=0.0.0.0
# WECOM_WEBHOOK_PORT=16672
# WECOM_WEBHOOK_PATH=/wecom

# DINGTALK_APP_KEY=...
# DINGTALK_APP_SECRET=...
# DINGTALK_CALLBACK_TOKEN=...
# DINGTALK_ENCODING_AES_KEY=...
# DINGTALK_DEFAULT_WEBHOOK=...
# DINGTALK_WEBHOOK_HOST=0.0.0.0
# DINGTALK_WEBHOOK_PORT=16673
# DINGTALK_WEBHOOK_PATH=/dingtalk

# QQ_BOT_APP_ID=...
# QQ_BOT_APP_SECRET=...
# QQ_SANDBOX=1
# QQ_WEBHOOK_HOST=0.0.0.0
# QQ_WEBHOOK_PORT=16674
# QQ_WEBHOOK_PATH=/qqbot

# ---- 语音识别 STT（可选，全部不填则禁用）----
# 优先顺序由 STT_PROVIDERS 控制
# STT_PROVIDERS=groq,openai-whisper,deepgram,google-gemini,local-cli
# STT_LANGUAGE=zh

# Groq STT
# GROQ_API_KEY=gsk_...
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Whisper STT
# STT_OPENAI_MODEL=whisper-1
# STT_OPENAI_BASE_URL=https://api.openai.com/v1

# Deepgram STT
# DEEPGRAM_API_KEY=...
# STT_DEEPGRAM_MODEL=nova-2
# STT_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1

# Google Gemini STT
# GOOGLE_API_KEY=...
# STT_GOOGLE_MODEL=gemini-2.0-flash
# STT_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local CLI STT
# STT_LOCAL_COMMAND=whisper

# ---- 其他（可选）----
# TUI_PROJECT_DIR=D:/my-project
# OPENCORVUS_CHANNEL_PERMISSION_PROFILE=standard
# valid values: restricted | standard | permissive | passthrough
# OPENCORVUS_CHANNEL_SESSION_QUEUE_LIMIT=20
# OPENCORVUS_CHANNEL_PERMISSION_ASK_REPLY=reject
# valid values: once | always | reject

# ---- Optional bundled trial env (gentleman agreement) ----
# Bundle file is applied only for the first 24 hours after first use.
# User/system env vars always override bundled values.
# OPENCORVUS_CHANNEL_BUNDLED_ENV_FILE=.env.bundle
# OPENCORVUS_CHANNEL_BUNDLED_STATE_FILE=
# OPENCORVUS_CHANNEL_BUNDLED_TTL_HOURS=24

# ---- Overlay + shared-session integration ----
# Usually injected by overlay manager. Set manually only when needed.
# OPENCORVUS_CHANNEL_SERVER_URL=http://127.0.0.1:7878
# OPENCORVUS_SHARED_SESSION_MODE=1
# OPENCORVUS_SHARED_SESSION_FILE=.opencorvus/shared-session.json
# OPENCORVUS_MIRROR_STDOUT=1

# Assistant screenshot status visibility threshold (percent)
# OPENCORVUS_MONITOR_DIFF_THRESHOLD=2

# Include tool input details in channel runtime status messages: 1 to enable
# OPENCORVUS_CHANNEL_DEBUG_TOOL_INPUT=0

# JSON config override injected at runtime (advanced)
# OPENCORVUS_CONFIG_CONTENT=

# Project root for Claude channel helper script (advanced)
# OPENCORVUS_PROJECT_DIR=

# ---- Overlay runtime tuning (opencorvus process) ----
# Overlay binary path override
# OPENCORVUS_OVERLAY_BIN=
# Disable overlay entirely: 1 to disable
# OPENCORVUS_OVERLAY_DISABLED=0
# Process policy: kill-old-start-new | reuse
# OPENCORVUS_OVERLAY_SINGLETON_MODE=kill-old-start-new
# Retry / circuit-breaker tuning for overlay sidecar
# OPENCORVUS_OVERLAY_RETRY_BASE_MS=250
# OPENCORVUS_OVERLAY_RETRY_MAX_MS=5000
# OPENCORVUS_OVERLAY_CIRCUIT_WINDOW_MS=30000
# OPENCORVUS_OVERLAY_CIRCUIT_THRESHOLD=6
# OPENCORVUS_OVERLAY_CIRCUIT_COOLDOWN_MS=30000

# ---- Test / diagnostics ----
# Auto-inject prompt after channel runtime startup (test only)
# TEST_PROMPT=
# Channel used together with TEST_PROMPT
# SLACK_CHANNEL_ID=C08XXXXXXXX
# Extra CA bundle path for TLS environments that need custom certs
# SSL_CERT_FILE=

# ---- System path overrides (usually leave unset) ----
# APPDATA=
# LOCALAPPDATA=
# XDG_DATA_HOME=
# XDG_STATE_HOME=

# ---- Internal vars (do not set manually) ----
# OPENCORVUS_OVERLAY_MODE=sidecar
# OPENCORVUS_OVERLAY_STDIN_EXIT=1
# OPENCORVUS_EMBEDDED_OVERLAY_B64=
# OPENCORVUS_EMBEDDED_OVERLAY_HASH=


