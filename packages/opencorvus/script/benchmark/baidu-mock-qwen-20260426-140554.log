/**
 * Mock data for search autocomplete suggestions (搜索建议)
 * Simulates Baidu search suggestion API responses
 */

const SUGGESTION_MAP = {
  '李小冉': ['李小冉自曝洗头需心理建设', '李小冉 电视剧', '李小冉 个人资料', '李小冉 老公'],
  '稀土': ['稀土公司副总向境外泄露', '稀土价格最新行情', '稀土是什么', '稀土概念股'],
  '中国新电池': ['中国新电池来了', '中国新能源汽车电池', '中国电池技术突破'],
  '默认': ['百度热搜', '百度翻译', '百度地图', '百度网盘', '百度文库'],
};

/**
 * Get search suggestions for a given query
 * @param {string} query - User input text
 * @returns {string[]}
 */
export function getSearchSuggestions(query) {
  if (!query || query.trim() === '') {
    return SUGGESTION_MAP['默认'];
  }
  for (const key of Object.keys(SUGGESTION_MAP)) {
    if (key !== '默认' && query.includes(key)) {
      return SUGGESTION_MAP[key];
    }
  }
  return [query + ' 是什么', query + ' 最新消息', query + ' 百度百科', query + ' 相关新闻'];
}
