INFO  2026-04-21T07:11:57 +0ms service=decision-log taskID=tsk_daedf279b001dj3e8bBhyncmT5 key=naming_convention value=## TypeScript and route naming conventions
- Files: backend modules use `kebab-case.ts`; React components use `PascalCase.tsx`; page components use `PascalCasePage.tsx`.
- Types/interfaces: `PascalCase`.
- Functions/hooks: `camelCase` for functions, `useCamelCase` for hooks.
- Route helpers: `createXRoutes(app)` for Hono route installers.
- SSE/event payload keys: `snake_case` only where required by persisted data or PRD examples; otherwise use `camelCase` in TypeScript objects.
- Stock codes and enum-like literals must reuse the canonical union type from shared types; do not duplicate string literals outside constants or tests.
- Numeric display helpers must keep formatting isolated in UI utilities, not embedded in route handlers. phase=architect decision logged
INFO  2026-04-21T07:11:57 +1ms service=decision-log taskID=tsk_daedf279b001dj3e8bBhyncmT5 key=dependency_order value=## Backend, frontend, and integration wiring order
- `gol_daee1045c002FOTQ82q1ZNhYkz` must land first because every backend and frontend goal consumes the canonical `StockCode`, `Stock`, `AuthUser`, and `ApiError` shapes.
- `gol_daee1045c003tHmFWp6Y0ippO3` must follow bootstrap because it defines auth/session and market stream contracts consumed by all feature routes and the frontend shell.
- `gol_daee1045c004S66VZnS86EA9eU` depends on both bootstrap and auth/market because trading, portfolio, and history routes require the stock/session contracts and market feed helpers.
- `gol_daee1045c00595bFsOQwyTNBuK` should be wired after bootstrap and auth/market, but before feature pages, because it provides the API client, routing shell, and connection-state type consumed by all UI goals.
- `gol_daee1045c006hwuDpB4SUn0ZS0` and `gol_daee1045c007rv3drMUGKTZv1p` may be implemented in parallel after the frontend shell and backend route contracts stabilize.
- `gol_daee1045c008pNAsFjH3SBZxUK` must be last for wiring `index.ts`, static hosting, and startup/test integration once all route installers and the frontend router are available. phase=architect decision logged
INFO  2026-04-21T07:11:57 +0ms service=decision-log taskID=tsk_daedf279b001dj3e8bBhyncmT5 key=shared_type value=## Canonical backend domain types
```ts
// src/types.ts
export type StockCode =
  | "SH600001"
  | "SH600002"
  | "SH600003"
  | "SH600004"
  | "SH600005"
  | "SH600006"
  | "SH600007"
  | "SH600008"
  | "SH600009"
  | "SH600010";

export type OrderDirection = "buy" | "sell";
export type OrderStatus = "pending" | "filled" | "cancelled";
export type NewsSentiment = "positive" | "negative" | "neutral";
export type NewsImpact = "high" | "medium" | "low";
export type ConnectionState = "connected" | "reconnecting" | "disconnected";

export interface ApiError {
  error: string;
}

export interface AuthUser {
  id: number;
  username: string;
  balance: number;
  frozen_balance: number;
  created_at: number;
}

export interface Stock {
  code: StockCode;
  name: string;
  open_price: number;
  current_price: number;
  high_price: number;
  low_price: number;
  prev_close: number;
  volume: number;
  trend: number;
  updated_at: number;
}

export interface SessionUser {
  token: string;
  user_id: number;
}

export interface Order {
  id: number;
  stock_code: StockCode;
  stock_name: string;
  direction: OrderDirection;
  quantity: number;
  price: number;
  frozen_amount: number;
  status: OrderStatus;
  filled_at: number | null;
  created_at: number;
}

export interface Position {
  stock_code: StockCode;
  stock_name: string;
  quantity: number;
  available_quantity: number;
  cost_basis: number;
  current_price: number;
  market_value: number;
  profit_loss: number;
  profit_loss_percent: number;
}

export interface NewsItem {
  id: string;
  stock_code: StockCode | "MARKET";
  title: string;
  summary: string;
  sentiment: NewsSentiment;
  source: string;
  impact: NewsImpact;
  created_at: number;
}

export interface KLinePoint {
  time: number;
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
  ma5: number;
  ma10: number;
  ma20: number;
  macd_dif: number;
  macd_dea: number;
  macd_bar: number;
}

export interface MarketOverview {
  up_count: number;
  down_count: number;
  flat_count: number;
  total_volume: number;
  top_gainers: Array<{ code: StockCode; name: string; change_percent: number }>;
  top_losers: Array<{ code: StockCode; name: string; change_percent: number }>;
}

export interface PortfolioSummary {
  total_assets: number;
  balance: number;
  frozen_balance: number;
  market_value: number;
  total_profit_loss: number;
  total_profit_loss_percent: number;
}

export interface ExposureSummary {
  position_count: number;
  concentration: number;
  largest_position: { stock_code: StockCode; stock_name: string; weight: number } | null;
  profitable_count: number;
  losing_count: number;
}
