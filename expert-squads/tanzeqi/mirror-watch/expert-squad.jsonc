{
  "schema_version": 1,
  "namespace": "tanzeqi",
  "id": "mirror-watch",
  "name": "MirrorWatch",
  "label": "MirrorWatch",
  "description": "The author-defined AInvest survey, deterministic aggregation, and report delivery through durable catalog facts and visible narrative Turn summaries.",
  "version": "2026.08.05.2",
  "product_pillars": ["code"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for the complete AInvest expert/persona survey and deterministic report delivery.",
    "selection_guidance": "Select Mirror Watch only for the full AInvest F01-F10, Denis/Oleg, explicit-persona, and 3-2-1 report contract.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": ["dispatch_agent", "manage_task", "read"],
      "package_skill_refs": ["mirror-watch/shared/delivery-contract"],
      "default_skill_refs": [],
      "default_tool_refs": [],
      "package_tool_refs": ["mirror-watch/shared/personas"],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "mirror-watch-requirements-analyst": {
        "label": "Mirror Watch Requirements Analyst",
        "description": "Persists the complete Mirror Watch acceptance contract and exact Task-selected cohort/workflow constraints before Delivery Slice decomposition.",
