#!/usr/bin/env bash

set -euo pipefail

ARG=${1:-patch}

if [[ "$ARG" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]]; then
  VERSION="$ARG"
else
  case "$ARG" in
    patch|minor|major) ;;
    *)
      echo "Usage: ./script/release [patch|minor|major|x.y.z]"
      exit 1
      ;;
  esac

  VERSION=$(bun -e 'const bump = process.argv[2] ?? "patch"
const pkg = await Bun.file("packages/opencorvus/package.json").json()
const latest = typeof pkg.version === "string" ? pkg.version.trim() : ""
if (!latest) {
  throw new Error("missing version in packages/opencorvus/package.json")
}
const [major, minor, patch] = latest.split(".").map((item) => Number(item) || 0)
if (bump === "major") {
  console.log(`${major + 1}.0.0`)
  process.exit(0)
}
if (bump === "minor") {
  console.log(`${major}.${minor + 1}.0`)
  process.exit(0)
}
console.log(`${major}.${minor}.${patch + 1}`)' "$ARG")
fi

echo "Dispatching build.yml for v$VERSION"
gh workflow run build.yml -f "version=$VERSION"
