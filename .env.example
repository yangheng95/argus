# ══════════════════════════════════════════════════════════════
# Argus — Autonomous Development Guardian
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ══════════════════════════════════════════════════════════════

# ── TUI Configuration ─────────────────────────────────────
# Which TUI tool to drive: auto | argus | claude-code | codex | aider | generic
ARGUS_TUI_TYPE=auto
# Path to TUI binary (optional, used by tuiCommand)
# ARGUS_TUI_BIN=
# Extra CLI arguments for the TUI
# ARGUS_TUI_ARGS=
# Window title pattern for finding the TUI window (auto-resolved from TUI type if empty)
# ARGUS_TUI_WINDOW_PATTERN=

# ── Perception ─────────────────────────────────────────────
CAPTURE_INTERVAL_SECONDS=5
OCR_ENGINE=vision

# ── Vision (Qwen VL) ────────────────────────────────────────
# API key for Qwen vision model (Bailian Coding Plan or DashScope)
BAILIAN_CODING_PLAN_API_KEY=sk-sp-...
# DASHSCOPE_API_KEY=sk-...          # Alternative key
ARGUS_VISION_MODEL=qwen3.5-plus
# ARGUS_VISION_BASE_URL=            # Leave empty for auto-detect
# ARGUS_VISION_MAX_TOKENS=512

# ── Brain (ReAct Decision Engine) ────────────────────────
# 启用 Brain 后，Argus 将使用 LLM 做智能决策而非硬编码状态机
# ARGUS_BRAIN_ENABLED=false
# ARGUS_BRAIN_API_KEY=              # 留空则使用 Vision 的 API key
# ARGUS_BRAIN_MODEL=
# ARGUS_BRAIN_BASE_URL=             # 留空则使用 Vision 的 endpoint
# ARGUS_BRAIN_MAX_TOKENS=2048
# ARGUS_BRAIN_MAX_OBSERVATIONS=10   # 上下文中保留多少条屏幕观察
# ARGUS_BRAIN_MAX_CALLS_PER_TASK=20 # 单任务最多调用 Brain 多少次
# ARGUS_BRAIN_COOLDOWN=3            # Brain 调用最小间隔（秒）

# ── Slack ──────────────────────────────────────────────────
# 1. Create a Slack App at https://api.slack.com/apps
# 2. Add Bot Token Scopes: chat:write, channels:read
# 3. Enable Socket Mode and generate an App-level Token (xapp-...)
# 4. Install app to workspace → copy Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C08XXXXXXXX
SLACK_ALLOWED_USER_IDS=U01234567,U09876543
SLACK_USER_TOKEN=xoxp-...

# ── Telegram (optional) ───────────────────────────────────
# 1. Message @BotFather on Telegram to create a bot
# 2. Get your chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN=123456789:AAF...
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
