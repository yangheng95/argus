INFO  2026-04-21T12:41:08 +72761ms service=decision-log taskID=tsk_db00c15330018H6SEwGjekcx1M key=directory_blueprint value=## Repository directory blueprint for shared contracts and app modules
```text
src/
  types.ts          — shared domain types and API DTOs consumed by backend, frontend, and tests
  contracts.ts      — re-export surface for shared contract symbols; keep as the single import hub
  db.ts             — SQLite DDL, seeds, and persistence helpers
  auth.ts           — authentication/session routes and helpers
  market.ts         — market queries, watchlist, and SSE routes
  trading.ts        — order submission, cancellation, and order query routes
  portfolio.ts      — holdings and asset summary routes
  history.ts        — trade history and replay routes
  simulator.ts      — market tick simulation and matching engine
  news.ts           — in-memory news generation and query helpers
  risk.ts           — order validation and risk checks

web/
  src/
    api.ts          — browser API client and SSE subscription helpers; consume shared contracts only
    components/
      shared/       — reusable UI primitives (AnimatedNumber, Toast, etc.)
      market/       — market page components
      trading/      — stock detail and order panel components
      portfolio/    — holdings and history page components
    pages/          — route-level page components
    hooks/          — UI and data hooks
    styles/
      theme.css     — Apple theme tokens and global styles

index.ts            — Hono entrypoint that mounts all API routers and serves web/dist

tests/
  api.test.ts       — end-to-end API contract tests against the shared DTOs
``` phase=architect decision logged
INFO  2026-04-21T12:41:08 +1ms service=decision-log taskID=tsk_db00c15330018H6SEwGjekcx1M key=shared_type value=## Core domain and API DTOs
```ts
// src/types.ts
export type OrderStatus = 'pending' | 'filled' | 'cancelled'
export type TradeDirection = 'buy' | 'sell'
export type Sentiment = 'positive' | 'negative' | 'neutral'

export interface ApiError {
  error: string
}

export interface StockQuote {
  code: string
  name: string
  current_price: number
  change: number
  change_percent: number
  volume: number
  high_price: number
  low_price: number
  open_price: number
  prev_close: number
}

export interface UserAccount {
  id: number
  username: string
  balance: number
  frozen_balance: number
  created_at: number
}

export interface OrderDTO {
  id: number
  stock_code: string
  stock_name?: string
  direction: TradeDirection
  quantity: number
  price: number
  frozen_amount: number
  status: OrderStatus
  filled_at: number | null
  created_at: number
}

export interface PositionDTO {
  stock_code: string
  stock_name: string
  quantity: number
  available_quantity: number
  cost_basis: number
  current_price: number
  market_value: number
  profit_loss: number
  profit_loss_percent: number
}

export interface TradeDTO {
  id: number
  stock_code: string
  stock_name: string
  direction: TradeDirection
  quantity: number
  price: number
  amount: number
  status: OrderStatus
  filled_at: number | null
  created_at: number
}

export interface NewsItem {
  id: string
  stock_code: string
  title: string
  summary: string
  sentiment: Sentiment
  source: string
  impact: 'high' | 'medium' | 'low'
  created_at: number
}

export interface MarketSnapshot {
  stocks: StockQuote[]
  timestamp: number
}

export interface KLinePoint {
  time: number
  open: number
  high: number
  low: number
  close: number
  volume: number
  ma5: number
  ma10: number
  ma20: number
  macd_dif: number
  macd_dea: number
  macd_bar: number
}

export interface PortfolioSummary {
  total_assets: number
  balance: number
  frozen_balance: number
  market_value: number
  total_profit_loss: number
  total_profit_loss_percent: number
}
``` phase=architect decision logged
