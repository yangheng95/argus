# ---- å…¶ä»–ï¼ˆå¯é€‰ï¼‰----
# TUI_PROJECT_DIR=D:/my-project
# OPENCORVUS_BOT_PERMISSION_PROFILE=standard
# valid values: restricted | standard | permissive | passthrough
# OPENCORVUS_BOT_SESSION_QUEUE_LIMIT=20
# OPENCORVUS_BOT_PERMISSION_ASK_REPLY=reject
# valid values: once | always | reject

# ---- Optional bundled trial env (gentleman agreement) ----
# Bundle file is applied only for the first 24 hours after first use.
# User/system env vars always override bundled values.
# OPENCORVUS_BOT_BUNDLED_ENV_FILE=.env.bundle
# OPENCORVUS_BOT_BUNDLED_STATE_FILE=
# OPENCORVUS_BOT_BUNDLED_TTL_HOURS=24

# ---- Overlay + shared-session integration ----
# Usually injected by overlay manager. Set manually only when needed.
# OPENCORVUS_BOT_SERVER_URL=http://127.0.0.1:4096
# OPENCORVUS_SHARED_SESSION_MODE=1
# OPENCORVUS_SHARED_SESSION_FILE=.opencorvus/shared-session.json
# OPENCORVUS_MIRROR_STDOUT=1

# Assistant screenshot status visibility threshold (percent)
# OPENCORVUS_MONITOR_DIFF_THRESHOLD=2

# Include tool input details in bot status messages: 1 to enable
# OPENCORVUS_BOT_DEBUG_TOOL_INPUT=0

# JSON config override injected at runtime (advanced)
# OPENCORVUS_CONFIG_CONTENT=

# Project root for claude-bot helper script (advanced)
# OPENCORVUS_PROJECT_DIR=

# ---- Overlay runtime tuning (opencorvus process) ----
# Overlay binary path override
# OPENCORVUS_OVERLAY_BIN=
# Disable overlay entirely: 1 to disable
# OPENCORVUS_OVERLAY_DISABLED=0
# Process policy: kill-old-start-new | reuse
# OPENCORVUS_OVERLAY_SINGLETON_MODE=kill-old-start-new
# Retry / circuit-breaker tuning for overlay sidecar
# OPENCORVUS_OVERLAY_RETRY_BASE_MS=250
# OPENCORVUS_OVERLAY_RETRY_MAX_MS=5000
# OPENCORVUS_OVERLAY_CIRCUIT_WINDOW_MS=30000
# OPENCORVUS_OVERLAY_CIRCUIT_THRESHOLD=6
# OPENCORVUS_OVERLAY_CIRCUIT_COOLDOWN_MS=30000

# ---- Test / diagnostics ----
# Auto-inject prompt after bot startup (test only)
# TEST_PROMPT=
# Channel used together with TEST_PROMPT
# SLACK_CHANNEL_ID=C08XXXXXXXX
# Extra CA bundle path for TLS environments that need custom certs
# SSL_CERT_FILE=

# ---- System path overrides (usually leave unset) ----
# APPDATA=
# LOCALAPPDATA=
# XDG_DATA_HOME=
# XDG_STATE_HOME=

# ---- Internal vars (do not set manually) ----
# OPENCORVUS_OVERLAY_MODE=sidecar
# OPENCORVUS_OVERLAY_STDIN_EXIT=1
# OPENCORVUS_EMBEDDED_OVERLAY_B64=
# OPENCORVUS_EMBEDDED_OVERLAY_HASH=

