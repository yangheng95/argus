    ],
  },
  "apply_patch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "patchText": {
        "description": "The full patch text that describes all changes to be made",
        "type": "string",
      },
    },
    "required": [
