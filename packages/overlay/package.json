{
  "name": "@opencorvus-ai/overlay",
  "version": "0.0.1-alpha",
  "private": true,
  "scripts": {
    "check:i18n": "bun run script/check-panel-i18n.ts",
    "dev": "tauri dev",
    "dev:vite": "vite --config vite.config.ts",
    "build": "bun run check:i18n && bun run script/build.ts",
    "build:mainjs": "bun run script/build-main-js.ts",
    "build:vite": "vite build --config vite.config.ts",
    "build:docker": "bun run script/build-docker.ts",
    "test": "bun test --timeout 120000",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6",
    "vite-plugin-solid": "^2"
  },
  "dependencies": {
    "@opencorvus-ai/plugin": "0.0.1-alpha",
    "solid-js": "^1"
  }
}