---
const locale = Astro.props.locale === "zh" ? "zh" : "en"
---

<section class="oc-arch-explorer" data-oc-architecture-explorer data-locale={locale}>
  <div class="oc-arch-head">
    <p class="oc-arch-eyebrow">
      {locale === "zh" ? "OpenCorvus current architecture" : "OpenCorvus current architecture"}
    </p>
    <h2>
      {locale === "zh" ? "企业级动态架构图" : "Enterprise Architecture Explorer"}
    </h2>
    <p>
      {
        locale === "zh"
          ? "点击领域、组件和细分节点，逐层查看当前源码里的职责、证据、边界和运行关系。"
          : "Click domains, components, and detail nodes to inspect current responsibilities, evidence, boundaries, and runtime relationships."
      }
    </p>
  </div>

  <div class="oc-arch-toolbar" aria-label={locale === "zh" ? "架构图控制栏" : "Architecture controls"}>
    <label class="oc-arch-search">
      <span>{locale === "zh" ? "搜索架构事实" : "Search architecture facts"}</span>
      <input data-arch-search type="search" autocomplete="off" />
    </label>
    <div class="oc-arch-view-controls" data-arch-view-controls aria-label={locale === "zh" ? "视图模式" : "View mode"}>
    </div>
    <button class="oc-arch-reset" type="button" data-arch-reset>
      {locale === "zh" ? "重置" : "Reset"}
    </button>
  </div>

  <div class="oc-arch-path" data-arch-path aria-live="polite"></div>

  <div class="oc-arch-workbench">
    <nav class="oc-arch-rail" data-arch-rail aria-label={locale === "zh" ? "架构领域" : "Architecture domains"}>
    </nav>

    <div class="oc-arch-stage">
      <div class="oc-arch-canvas" data-arch-canvas>
        <svg class="oc-arch-links" data-arch-links aria-hidden="true"></svg>
        <div class="oc-arch-map" data-arch-map></div>
      </div>

      <div class="oc-arch-edge-strip" data-arch-edge-strip aria-label={locale === "zh" ? "当前关系" : "Current relationships"}>
      </div>

      <div class="oc-arch-layer-panel" data-arch-layer-panel>
      </div>
    </div>

    <aside class="oc-arch-inspector" data-arch-inspector aria-live="polite">
    </aside>
  </div>

  <div class="oc-arch-evidence" data-arch-evidence>
  </div>
</section>

<style is:global>
  .oc-arch-explorer {
    --oc-arch-ink: var(--sl-color-white);
    --oc-arch-muted: var(--sl-color-gray-3);
    --oc-arch-line: color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
    --oc-arch-panel: color-mix(in srgb, var(--sl-color-gray-6) 56%, transparent);
    --oc-arch-panel-strong: color-mix(in srgb, var(--sl-color-gray-6) 82%, transparent);
    --oc-arch-focus: #2fb8a6;
    --oc-arch-data: #5a8dee;
    --oc-arch-agent: #d29b38;
    --oc-arch-review: #c06c84;
    --oc-arch-runtime: #6da55f;
    width: 100%;
    max-width: 1180px;
    margin: 2rem 0 2.5rem;
    color: var(--oc-arch-ink);
  }

  .oc-arch-explorer * {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  .oc-arch-head {
    display: grid;
    gap: 0.45rem;
    max-width: 840px;
    margin-bottom: 1rem;
  }

  .oc-arch-eyebrow {
    margin: 0;
    color: var(--oc-arch-focus);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .oc-arch-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2.35rem);
    line-height: 1.08;
  }

  .oc-arch-head p {
    margin: 0;
    color: var(--oc-arch-muted);
  }

  .oc-arch-toolbar {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto auto;
    gap: 0.75rem;
    align-items: end;
    padding: 0.75rem;
    border: 1px solid var(--oc-arch-line);
    border-radius: 8px;
    background: var(--oc-arch-panel);
  }

  .oc-arch-search {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    color: var(--oc-arch-muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .oc-arch-search input {
    width: 100%;
    min-height: 2.35rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--oc-arch-line);
    border-radius: 6px;
    color: var(--oc-arch-ink);
    background: color-mix(in srgb, var(--sl-color-black) 26%, transparent);
  }

  .oc-arch-view-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
  }

  .oc-arch-view-button,
  .oc-arch-reset,
  .oc-arch-rail-button,
  .oc-arch-node,
  .oc-arch-chip,
  .oc-arch-edge-button {
    border: 1px solid var(--oc-arch-line);
    border-radius: 6px;
    color: var(--oc-arch-ink);
    background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .oc-arch-view-button,
  .oc-arch-reset {
    min-height: 2.35rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.82rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .oc-arch-view-button[aria-pressed="true"],
  .oc-arch-reset:hover,
  .oc-arch-rail-button[aria-current="true"],
  .oc-arch-node[aria-pressed="true"],
  .oc-arch-chip[aria-pressed="true"],
  .oc-arch-edge-button[aria-pressed="true"] {
    border-color: var(--oc-arch-focus);
    background: color-mix(in srgb, var(--oc-arch-focus) 18%, var(--sl-color-gray-6));
  }

  .oc-arch-rail-button[data-match="true"],
  .oc-arch-node[data-match="true"],
  .oc-arch-chip[data-match="true"] {
    box-shadow: inset 0 0 0 1px var(--oc-arch-agent), 0 10px 26px rgba(0, 0, 0, 0.18);
  }

  .oc-arch-view-button:focus-visible,
  .oc-arch-reset:focus-visible,
  .oc-arch-rail-button:focus-visible,
  .oc-arch-node:focus-visible,
  .oc-arch-chip:focus-visible,
  .oc-arch-edge-button:focus-visible,
  .oc-arch-search input:focus-visible {
    outline: 2px solid var(--oc-arch-focus);
    outline-offset: 2px;
  }

  .oc-arch-path {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 2.2rem;
    align-items: center;
    color: var(--oc-arch-muted);
    font-size: 0.82rem;
  }

  .oc-arch-path span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .oc-arch-workbench {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 320px;
    gap: 0.85rem;
    align-items: stretch;
  }

  .oc-arch-rail,
  .oc-arch-stage,
  .oc-arch-inspector,
  .oc-arch-evidence {
    border: 1px solid var(--oc-arch-line);
    border-radius: 8px;
    background: var(--oc-arch-panel);
  }

  .oc-arch-rail {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 0.65rem;
  }

  .oc-arch-rail-button {
    display: grid;
    gap: 0.25rem;
    min-height: 4.2rem;
    padding: 0.6rem;
  }

  .oc-arch-rail-button strong,
  .oc-arch-node-title,
  .oc-arch-chip strong {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .oc-arch-rail-button span,
  .oc-arch-node-meta,
  .oc-arch-chip span {
    color: var(--oc-arch-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .oc-arch-node-meta {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .oc-arch-stage {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.75rem;
  }

  .oc-arch-canvas {
    position: relative;
    overflow-x: auto;
    min-height: 410px;
    border: 1px solid color-mix(in srgb, var(--oc-arch-line) 72%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--sl-color-gray-6) 48%, transparent) 1px, transparent 1px),
      linear-gradient(0deg, color-mix(in srgb, var(--sl-color-gray-6) 48%, transparent) 1px, transparent 1px);
    background-size: 96px 96px;
  }

  .oc-arch-map {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, minmax(150px, 1fr));
    grid-template-rows: repeat(4, 7.75rem);
    gap: 0.7rem;
    min-width: 1080px;
    min-height: 550px;
    padding: 1rem;
  }

  .oc-arch-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 1080px;
    pointer-events: none;
  }

  .oc-arch-links path {
    fill: none;
    stroke: color-mix(in srgb, var(--oc-arch-focus) 70%, var(--sl-color-gray-3));
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.72;
  }

  .oc-arch-node {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.4rem;
    min-height: 0;
    padding: 0.7rem;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
  }

  .oc-arch-node[hidden],
  .oc-arch-rail-button[hidden] {
    display: none;
  }

  .oc-arch-node-kicker {
    width: fit-content;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--sl-color-black);
    background: var(--oc-arch-focus);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .oc-arch-node[data-tone="data"] .oc-arch-node-kicker {
    background: var(--oc-arch-data);
  }

  .oc-arch-node[data-tone="agent"] .oc-arch-node-kicker {
    background: var(--oc-arch-agent);
  }

  .oc-arch-node[data-tone="review"] .oc-arch-node-kicker {
    background: var(--oc-arch-review);
  }

  .oc-arch-node[data-tone="runtime"] .oc-arch-node-kicker {
    background: var(--oc-arch-runtime);
  }

  .oc-arch-node-title {
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .oc-arch-node-count {
    display: inline-flex;
    width: fit-content;
    color: var(--oc-arch-muted);
    font-size: 0.7rem;
  }

  .oc-arch-edge-strip {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
  }

  .oc-arch-edge-button {
    flex: 0 0 13.5rem;
    min-height: 4rem;
    padding: 0.5rem;
    font-size: 0.76rem;
  }

  .oc-arch-edge-button strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.82rem;
  }

  .oc-arch-layer-panel {
    display: grid;
    gap: 0.75rem;
    min-height: 220px;
  }

  .oc-arch-layer-head,
  .oc-arch-chip-grid,
  .oc-arch-subpanel {
    border: 1px solid color-mix(in srgb, var(--oc-arch-line) 72%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--sl-color-gray-6) 44%, transparent);
  }

  .oc-arch-layer-head {
    padding: 0.75rem;
  }

  .oc-arch-layer-head h3,
  .oc-arch-inspector h3,
  .oc-arch-evidence h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  .oc-arch-layer-head p,
  .oc-arch-inspector p,
  .oc-arch-evidence p {
    margin: 0.35rem 0 0;
    color: var(--oc-arch-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .oc-arch-chip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.5rem;
    padding: 0.6rem;
  }

  .oc-arch-chip {
    display: grid;
    gap: 0.25rem;
    min-height: 4.8rem;
    padding: 0.55rem;
  }

  .oc-arch-subpanel {
    display: grid;
    gap: 0.5rem;
    padding: 0.65rem;
  }

  .oc-arch-inspector {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 0.75rem;
    min-width: 0;
  }

  .oc-arch-inspector-section {
    display: grid;
    gap: 0.45rem;
  }

  .oc-arch-inspector-section h4 {
    margin: 0;
    color: var(--oc-arch-focus);
    font-size: 0.76rem;
    text-transform: uppercase;
  }

  .oc-arch-inspector-section ul,
  .oc-arch-evidence ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.05rem;
  }

  .oc-arch-inspector-section li,
  .oc-arch-evidence li {
    color: var(--oc-arch-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .oc-arch-inspector code,
  .oc-arch-evidence code {
    white-space: normal;
    overflow-wrap: anywhere;
    font-size: 0.75rem;
  }

  .oc-arch-evidence {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.85rem;
    padding: 0.75rem;
  }

  .oc-arch-evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.55rem;
  }

  .oc-arch-evidence-card {
    min-width: 0;
    padding: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--oc-arch-line) 74%, transparent);
    border-radius: 8px;
    background: var(--oc-arch-panel-strong);
  }

  .oc-arch-evidence-card strong {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.82rem;
  }

  @media (max-width: 1320px) {
    .oc-arch-toolbar {
      grid-template-columns: 1fr;
    }

    .oc-arch-view-controls {
      justify-content: stretch;
    }

    .oc-arch-view-button,
    .oc-arch-reset {
      flex: 1 1 9rem;
      text-align: center;
    }

    .oc-arch-workbench {
      grid-template-columns: 1fr;
    }

    .oc-arch-rail {
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    }

    .oc-arch-map {
      grid-template-columns: repeat(3, minmax(150px, 1fr));
      grid-template-rows: repeat(4, 7.75rem);
      min-width: 0;
      min-height: 550px;
    }

    .oc-arch-links {
      min-width: 0;
    }

    .oc-arch-node {
      grid-template-rows: auto auto auto;
      align-content: center;
      justify-items: center;
      text-align: center;
    }

    .oc-arch-node-meta {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .oc-arch-view-button,
    .oc-arch-reset {
      flex-basis: 100%;
    }
  }
</style>

<script is:inline>
  (() => {
    const viewModes = [
      { id: "overview", label: { en: "Overview", zh: "总览" } },
      { id: "runtime", label: { en: "Runtime chain", zh: "运行链路" } },
      { id: "data", label: { en: "Data lineage", zh: "数据血缘" } },
      { id: "a2a", label: { en: "A2A coordination", zh: "A2A 协作" } },
      { id: "overlay", label: { en: "Overlay view", zh: "Overlay 展示" } },
    ]

    const domains = [
      {
        id: "input-control",
        lane: { en: "Control", zh: "入口" },
        title: { en: "Input & Control", zh: "入口与控制" },
        summary: {
          en: "Channels, local panel commands, and HTTP routes convert external intent into task records and visible control actions.",
          zh: "Channel、Panel 控制与 HTTP 路由把外部意图转成 task 记录和可见控制操作。",
        },
        tone: "runtime",
        position: { col: 1, row: 2 },
        views: ["overview", "runtime"],
        sources: [
          "packages/opencorvus/src/channel/ingress.ts",
          "packages/opencorvus/src/control/message.ts",
          "packages/opencorvus/src/server/routes/**",
          "specs/new-arch/03-control.md",
        ],
        constraints: [
          {
            en: "Control-plane routes work outside a project directory; project-scoped writes run inside Instance.provide.",
            zh: "控制面路由不依赖项目目录；项目作用域写操作运行在 Instance.provide 内部。",
          },
          {
            en: "Task-record reads resolve ownership from the task record instead of the active workspace.",
            zh: "Task 记录读取从 task 记录解析归属，而不是依赖当前工作区。",
          },
        ],
        components: [
          {
            id: "channel-ingress",
            title: { en: "ChannelIngress", zh: "ChannelIngress" },
            summary: { en: "Binds external channel messages to task creation and follow-up events.", zh: "把外部 channel 消息绑定到 task 创建与后续事件。" },
            sources: ["packages/opencorvus/src/channel/ingress.ts", "specs/new-arch/03-control.md"],
            details: [
              { en: "Preserves channel binding rows so replies can return to the same external thread.", zh: "保留 channel binding 行，让回复回到同一个外部 thread。" },
              { en: "Feeds the engine through task and message APIs instead of side-channel UI state.", zh: "通过 task/message API 进入 engine，而不是旁路 UI 状态。" },
            ],
            subsystems: [
              { id: "channel-binding", title: { en: "engine_channel_binding", zh: "engine_channel_binding" }, summary: { en: "Thread ownership for external platforms.", zh: "外部平台 thread 归属记录。" }, sources: ["packages/opencorvus/src/engine/engine.sql.ts"] },
              { id: "channel-runtime", title: { en: "Channel runtimes", zh: "Channel runtimes" }, summary: { en: "Slack, Discord, Feishu, DingTalk, WeCom, Telegram, and related adapters.", zh: "Slack、Discord、飞书、钉钉、企业微信、Telegram 等适配。" }, sources: ["packages/channel-runtime"] },
            ],
          },
          {
            id: "control-message",
            title: { en: "ControlMessage", zh: "ControlMessage" },
            summary: { en: "Routes local overlay and panel intent through declared capabilities.", zh: "通过声明式 capability 路由本地 overlay 与 panel 意图。" },
            sources: ["packages/opencorvus/src/control/message.ts", "packages/opencorvus/src/panel/capability.ts"],
            details: [
              { en: "Panel capability actions are explicit operations, not hidden UI-only messages.", zh: "Panel capability action 是显式操作，不是只给界面看的隐藏消息。" },
              { en: "Failures must remain visible to the caller and to the task stream.", zh: "失败必须对调用方和 task stream 可见。" },
            ],
            subsystems: [
              { id: "panel-registry", title: { en: "PanelCapabilityRegistry", zh: "PanelCapabilityRegistry" }, summary: { en: "Declared local UI capabilities.", zh: "声明本地 UI capability。" }, sources: ["packages/opencorvus/src/panel/capability.ts"] },
            ],
          },
          {
            id: "routes",
            title: { en: "Server routes", zh: "Server routes" },
            summary: { en: "Hono/OpenAPI route groups expose control, project, task, browser-preview, and panel surfaces.", zh: "Hono/OpenAPI 路由组暴露控制面、项目、task、browser-preview 与 panel 表面。" },
            sources: ["packages/opencorvus/src/server/routes/orchestrator.ts", "packages/opencorvus/src/server/routes/panel.ts", "packages/opencorvus/src/server/routes/browser-preview.ts"],
            details: [
              { en: "`POST /task` creates engine tasks; task event routes stream visible progress.", zh: "`POST /task` 创建 engine task；task event 路由流式展示进度。" },
              { en: "Browser Preview routes are task-scoped and evidence-backed.", zh: "Browser Preview 路由以 task 为作用域，并由证据支撑。" },
            ],
            subsystems: [
              { id: "task-routes", title: { en: "Task routes", zh: "Task routes" }, summary: { en: "Create, inspect, retry, replan, cancel, and stream tasks.", zh: "创建、查看、重试、重规划、取消和流式读取 task。" }, sources: ["packages/opencorvus/src/server/routes/orchestrator.ts"] },
              { id: "preview-routes", title: { en: "Browser Preview routes", zh: "Browser Preview routes" }, summary: { en: "Select target, capture, compare, snapshot, and input.", zh: "选择 target、截图、比较、快照和输入。" }, sources: ["packages/opencorvus/src/server/routes/browser-preview.ts"] },
            ],
          },
        ],
      },
      {
        id: "engine-core",
        lane: { en: "Engine", zh: "Engine" },
        title: { en: "Task Engine", zh: "任务引擎" },
        summary: {
          en: "SQLite tables and artifact projections hold the durable task, spec, plan, goal, interaction, evidence, and event spine.",
          zh: "SQLite 表与 artifact 投影承载 task、spec、plan、goal、interaction、evidence 与 event 主干。",
        },
        tone: "data",
        position: { col: 2, row: 2 },
        views: ["overview", "runtime", "data", "a2a", "overlay"],
        sources: [
          "packages/opencorvus/src/engine/engine.sql.ts",
          "packages/opencorvus/src/task-api/index.ts",
          "packages/opencorvus/src/engine/describe.ts",
          "specs/new-arch/02-data.md",
        ],
        constraints: [
          { en: "`engine_goal.status` and separate evaluation tables are retired; progress derives from artifacts.", zh: "`engine_goal.status` 与独立 evaluation 表已退役；进度从 artifact 派生。" },
          { en: "`engine_artifact` carries runs, goal attempts, verification evidence, integrity attempts, reports, and A2A artifacts.", zh: "`engine_artifact` 承载 run、goal attempt、verification evidence、integrity attempt、report 与 A2A artifact。" },
        ],
        components: [
          {
            id: "engine-service",
            title: { en: "EngineService", zh: "EngineService" },
            summary: { en: "Creates tasks, replies to interactions, retries/replans, and projects boards.", zh: "创建 task、回复 interaction、重试/重规划，并投影 board。" },
            sources: ["packages/opencorvus/src/task-api/index.ts"],
