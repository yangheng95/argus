        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
    },
    "virtual_workflows": {
      "research-survey-report": {
        "label": "Research, Survey, and Report",
        "description": "Research establishes the feature inventory; independent expert and persona surveys may proceed in parallel before deterministic report aggregation.",
        "nodes": {
          "mirror-watch-requirements-analyst": {
            "agent_id": "mirror-watch-requirements-analyst",
            "description": "Persists the complete acceptance contract, full persona authority provenance, exact Task-selected cohort, evidence-channel constraint, and source-workflow invariants.",
            "depends_on": [],
          },
          "mirror-watch-workflow-architect": {
            "agent_id": "mirror-watch-workflow-architect",
            "description": "Creates the final-report Delivery Slice revision and its assembly ownership; Task-level predecessors publish the intermediate Artifacts.",
            "depends_on": ["mirror-watch-requirements-analyst"],
          },
          "mirror-watch-research-lead": {
            "agent_id": "mirror-watch-research-lead",
            "description": "Collects current primary evidence and publishes the Task-scoped ten-feature recommendation, Gantt, and survey contract.",
            "depends_on": ["mirror-watch-workflow-architect"],
          },
          "mirror-watch-expert-surveyor": {
            "agent_id": "mirror-watch-expert-surveyor",
            "description": "Publishes the Denis and Oleg expert-perspective Artifacts in one Task-scoped Turn.",
            "depends_on": ["mirror-watch-research-lead"],
          },
          "mirror-watch-persona-surveyor": {
            "agent_id": "mirror-watch-persona-surveyor",
            "description": "Publishes one independently grounded canonical vote for every exact Task-selected authority-backed identity.",
            "depends_on": ["mirror-watch-research-lead"],
          },
          "mirror-watch-report-analyst": {
            "agent_id": "mirror-watch-report-analyst",
            "description": "Validates the exact Task-selected cohort and creates the deterministic 3-2-1 report through the package tool.",
            "depends_on": ["mirror-watch-expert-surveyor", "mirror-watch-persona-surveyor"],
          },
        },
      },
    },
  },
}
