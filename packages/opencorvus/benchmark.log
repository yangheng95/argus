export const colors = {
  primary: '#3B82F6',           // Action buttons, chart highlights
  background: '#FFFFFF',         // Main page background
  surface: '#FFFFFF',            // Header, right sidebar
  surfaceLeft: '#F8F9FA',        // Left sidebar
  textPrimary: '#1A1A1A',        // Headings, labels, prices
  textSecondary: '#6B7280',      // Subtitles, muted labels
  textMuted: '#9CA3AF',          // Timestamps, helper text
  success: '#22C55E',            // Positive price changes, green candles
  error: '#EF4444',              // Negative price changes, red candles
  border: '#E5E7EB',             // Panel dividers, input borders
  chartGrid: '#F3F4F6',          // Chart grid lines
  
  // Moving Average colors
  ma1: '#8B5CF6',                // MA line 1
  ma2: '#F97316',                // MA line 2
  ma3: '#22C55E',                // MA line 3
  ma4: '#3B82F6',                // MA line 4
  ma5: '#EF4444',                // MA line 5
  
  // Button colors
  buttonPrimary: '#000000',      // Sign in, Accept
  buttonSecondary: '#FFFFFF',    // Trade, Preferences
  
  // Other
  infoBanner: '#E0F2FE',         // Quotes delayed banner
  nasdaqBadge: '#10B981',        // Green dot
} as const;

