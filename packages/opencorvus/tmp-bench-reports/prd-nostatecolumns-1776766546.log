```ts
export interface StockRow {
  code: string
  name: string
  open_price: number
  current_price: number
  high_price: number
  low_price: number
  prev_close: number
  volume: number
  trend: number
  updated_at: number
}

export interface UserRow {
  id: number
  username: string
  balance: number
  frozen_balance: number
  created_at: number
}

export interface SessionRow {
  token: string
  user_id: number
  created_at: number
}

export interface MarketSnapshot {
  stocks: StockRow[]
  timestamp: number
}

export interface AppContext {
  db: unknown
}
``` phase=architect decision logged
