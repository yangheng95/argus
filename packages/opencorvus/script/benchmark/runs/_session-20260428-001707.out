// mirror/design-tokens.ts
// Colors
export const colors = {
  background: '#FFFFFF',
  textPrimary: '#1A1A1A',
  textSecondary: '#666666',
  textMuted: '#999999',
  border: '#E5E5E5',
  surfaceHeader: '#FFFFFF',
  surfaceSidebar: '#F8F9FA',
  surfacePanel: '#FFFFFF',
  success: '#22C55E',
  successLight: '#DCFCE7',
  error: '#EF4444',
  errorLight: '#FEE2E2',
  buttonPrimary: '#000000',
  buttonSecondary: '#FFFFFF',
  iconDefault: '#6B7280',
  tabActive: '#000000',
  tabInactive: '#6B7280',
};

// Typography
export const typography = {
  headingLg: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 700, fontSize: '24px', lineHeight: '32px' },
  headingMd: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 600, fontSize: '18px', lineHeight: '24px' },
  headingSm: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 600, fontSize: '14px', lineHeight: '20px' },
  body: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 400, fontSize: '14px', lineHeight: '20px' },
  caption: { fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif', fontWeight: 400, fontSize: '12px', lineHeight: '16px' },
