// Shared types between backend and frontend

interface StockInfo {
  symbol: string;
  name: string;
  exchange: string;
  price: number;
  change: number;
  changePercent: number;
  marketStatus: 'open' | 'closed' | 'pre-market' | 'after-hours';
  preMarket: boolean;
  high: number;
  low: number;
  volume: number;
  turnover: number;
}

interface Candle {
  time: number;  // Unix timestamp
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

type Timeframe = '1d' | '1w' | '1m';

interface TechnicalIndicators {
  ma: MovingAveragePoint[];
  rsi: RSIPoint[];
  macd: MACDPoint[];
  bollinger: BollingerPoint[];
}

interface MovingAveragePoint {
  time: number;
  value: number;
}

interface RSIPoint {
  time: number;
  value: number;
}

interface MACDPoint {
  time: number;
  macd: number;
  signal: number;
  histogram: number;
}

interface BollingerPoint {
  time: number;
  upper: number;
  middle: number;
  lower: number;
}

interface WatchlistItem {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
}
