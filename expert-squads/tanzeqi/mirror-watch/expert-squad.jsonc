        "package_mcp_resource_refs": [],
      },
      "mirror-watch-research-lead": {
        "label": "Mirror Watch Research Lead",
        "description": "Collects current primary evidence and publishes the Task-scoped ten-feature recommendation, Gantt, and survey contract.",
        "base_role": "delegated-worker",
        "prompt": "agents/mirror-watch-research-lead/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "package_skill_refs": [
          "mirror-watch/shared/delivery-contract",
