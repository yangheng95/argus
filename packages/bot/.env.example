# ============================================================
# Argus Bot — 环境变量配置示例
# 复制为 .env 后填写，然后运行 bun dev 启动 Bot
# ============================================================

# ---- LLM 模型配置（必填）----
# 以 JSON 格式内联 Argus 配置，Bot 不读取项目目录中的配置文件
# 示例：Qwen（DashScope）
ARGUS_CONFIG_CONTENT={"model":"alibaba-cn/qwen3.5-plus","provider":{"alibaba-cn":{"options":{"baseURL":"https://coding.dashscope.aliyuncs.com/v1"}}},"permission":{"*":"deny","screen":"allow","input":"allow","bash":"allow","edit":"allow","write":"allow","read":"allow","glob":"allow","grep":"allow","skill":"allow","memory":"allow","schedule":"allow","planner":"allow","external_directory":"allow"}}

# 示例：Claude（Anthropic，取消注释并填写 Key）
# ARGUS_CONFIG_CONTENT={"model":"anthropic/claude-sonnet-4-6","provider":{"anthropic":{"env":"ANTHROPIC_API_KEY"}}}
# ANTHROPIC_API_KEY=sk-ant-...

# 示例：OpenAI（取消注释并填写 Key）
# ARGUS_CONFIG_CONTENT={"model":"openai/gpt-4o","provider":{"openai":{"env":"OPENAI_API_KEY"}}}
# OPENAI_API_KEY=sk-...

# ---- Slack 适配器（与 Telegram 二选一，或同时配置）----
# Slack App 需开启 Socket Mode，并订阅 message.channels / message.im 事件
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# ---- Telegram 适配器（可选）----
# TELEGRAM_BOT_TOKEN=...

# ---- 语音识别 STT（可选）----
# 优先顺序由 STT_PROVIDERS 控制，默认依次尝试可用提供商
# STT_PROVIDERS=groq,openai-whisper,deepgram,google-gemini,local-cli
# STT_LANGUAGE=zh
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# DEEPGRAM_API_KEY=...
# GOOGLE_API_KEY=...
# STT_LOCAL_COMMAND=whisper

# ---- DashScope API Key ----
# 支持两种 Key：
#   DASHSCOPE_API_KEY         — 标准 DashScope Key，用于 LLM + Vision
#   CODING_DASHSCOPE_API_KEY  — Coding Plan 专用 Key (sk-sp-*)，baseURL 使用 coding.dashscope
# 只需填一个即可。如果同时填写，DASHSCOPE_API_KEY 优先用于 Vision，
# CODING_DASHSCOPE_API_KEY 通过 baseURL 配置用于 LLM。
# DASHSCOPE_API_KEY=sk-...
# CODING_DASHSCOPE_API_KEY=sk-sp-...
# ARGUS_VISION_MODEL=qwen3.5-plus

# ---- 其他（可选）----
# Bot 指挥 TUI 工作的默认项目目录，默认使用 process.cwd()
# TUI_PROJECT_DIR=D:/my-project
