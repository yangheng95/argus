```ts
// From goal_data_engine → consumed by goal_backend_api and goal_frontend

export interface OHLCV {
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
  time: number; // Unix timestamp in seconds
}

export interface IndicatorValues {
  ma5: number;
  ma10: number;
  ma20: number;
  ma30: number;
  ma60: number;
  macd: number;
  signal: number;
  histogram: number;
  rsi: number;
}

export interface StockData {
  symbol: string;
  name: string;
  candles: OHLCV[];
  indicators: IndicatorValues[];
}

export interface StockInfo {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  high: number;
  low: number;
  volume: number;
  marketCap: string;
  pe: number;
  eps: number;
}
``` phase=architect decision logged
INFO  2026-04-28T01:22:43 +0ms service=decision-log taskID=tsk_dd1a374080011RUk5GR3GNTakv key=interface_contract value=## Data Engine Public API
```ts
// src/data-engine/index.ts exports

export function generateCandles(
  symbol: string,
  timeframe: '1m' | '5m' | '15m' | '1h' | '4h' | '1d' | '1w' | '1M',
  count: number,
  seed?: number
): OHLCV[];

export function calculateIndicators(candles: OHLCV[]): IndicatorValues[];

export function getStockInfo(symbol: string): StockInfo;

export const AVAILABLE_STOCKS: StockInfo[];
``` phase=architect decision logged
INFO  2026-04-28T01:22:43 +1ms service=decision-log taskID=tsk_dd1a374080011RUk5GR3GNTakv key=interface_contract value=## Hono API Routes
```ts
// From goal_backend_api → consumed by goal_frontend

// GET /api/stock/:symbol/info
interface StockInfoResponse {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  high: number;
  low: number;
  volume: number;
  marketCap: string;
  pe: number;
  eps: number;
}

// GET /api/stock/:symbol/candles?timeframe=1d&count=100
interface CandlesResponse {
  symbol: string;
  timeframe: string;
  candles: OHLCV[];
}

// GET /api/stock/:symbol/indicators?timeframe=1d
interface IndicatorsResponse {
  symbol: string;
  timeframe: string;
  indicators: IndicatorValues[];
}

// GET /api/stocks
interface StocksListResponse {
  stocks: StockInfo[];
}

// GET /api/health
interface HealthResponse {
  status: 'ok';
  timestamp: number;
}

// GET /api/stock/:symbol/stream (SSE)
// Events: price-update { symbol, price, change, changePercent, timestamp }
``` phase=architect decision logged
