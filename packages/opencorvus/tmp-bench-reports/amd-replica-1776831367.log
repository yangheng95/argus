├── server/
│   ├── index.ts          # Hono server entry
│   ├── routes/
│   │   └── stock.ts      # Stock API routes
│   ├── data/
│   │   ├── mockQuotes.ts # Mock quote data generator
│   │   └── mockChartData.ts # Mock chart data generator
│   └── test/
│       └── api.test.ts   # API endpoint tests
├── components/
│   ├── Header.tsx        # Site header with nav
│   ├── StockHeader.tsx   # Stock info display
│   ├── ChartContainer.tsx # Chart wrapper
│   ├── StockChart.tsx    # Lightweight Charts integration
│   ├── StatsPanel.tsx    # Stock statistics panel
│   ├── PeriodSelector.tsx # Time period buttons
│   ├── ChartTypeToggle.tsx # Line/candlestick toggle
│   └── Dropdown.tsx      # Generic dropdown
├── hooks/
│   ├── useStockData.ts   # Fetch stock quote hook
│   ├── useChartData.ts   # Fetch chart data hook
│   └── useResponsive.ts  # Responsive breakpoint hook
├── utils/
│   ├── api.ts            # API client functions
│   └── formatters.ts     # Number/date formatters
├── App.tsx               # Main application component
└── main.tsx              # React entry point

scripts/
├── start.ts              # Production start script
└── dev.ts                # Dev mode script

public/
└── assets/               # Static assets
