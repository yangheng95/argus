/**
 * Mock data for Baidu hot search list (百度热搜)
 * Matches visible content from reference screenshot
 */

const HOT_SEARCH_ITEMS = [
  { rank: 0, title: '总书记高度重视生态文明建设', tag: 'top' },
  { rank: 1, title: '稀土公司副总向境外泄露7项国家...', tag: '热' },
  { rank: 2, title: '中国新电池来了', tag: '热' },
  { rank: 3, title: '人民永远铭记 祖国永远记得', tag: '' },
  { rank: 4, title: '李幼斌6分钟替老兵走完70多年回...', tag: '新' },
  { rank: 5, title: '舞剧演员脱掉和服才向观众谢幕鞠躬', tag: '' },
  { rank: 6, title: '伊朗安全部队在边境开火', tag: '' },
  { rank: 7, title: '又是倒数第一 辽宁决心"翻身"', tag: '新' },
  { rank: 8, title: '老百姓大药房等药店被查', tag: '热' },
  { rank: 9, title: '美国多名科学家死亡失踪 FBI介入', tag: '新' },
];

/**
 * Get hot search list data
 * @returns {Array<{ rank: number; title: string; tag: string }>}
 */
export function getHotSearchList() {
  return HOT_SEARCH_ITEMS;
}

/**
 * Get a shuffled/rotated hot search list (for "换一换" refresh)
 * @returns {Array<{ rank: number; title: string; tag: string }>}
 */
export function refreshHotSearchList() {
  const shuffled = [...HOT_SEARCH_ITEMS].sort(() => Math.random() - 0.5);
  return shuffled.map((item, i) => ({ ...item, rank: i === 0 ? 0 : i }));
}
