// src/types/api.ts
export interface StockInfo {
  symbol: string;
  name: string;
  exchange: string;
  price: number;
  change: number;
  changePercent: number;
  marketOpen: boolean;
  preMarketPrice?: number;
  preMarketChange?: number;
}

export interface OHLCData {
  timestamp: number;
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

export interface StockStats {
  high: number;
  low: number;
  volume: number;
  turnover: number;
}

export interface Indicator {
  id: string;
  name: string;
  type: 'overlay' | 'oscillator';
}

export interface BuySellRatio {
  buyRatio: number;
  sellRatio: number;
  bid: number;
  ask: number;
}
