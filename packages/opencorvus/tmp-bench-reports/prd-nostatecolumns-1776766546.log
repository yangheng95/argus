```ts
export function registerUser(input: { username: string; password: string }): Promise<{ user: UserRow; token: string }>
export function loginUser(input: { username: string; password: string }): Promise<{ user: UserRow; token: string }>
export function getCurrentUser(token: string): Promise<UserRow>
export function logoutUser(token: string): Promise<void>

