  stock: StockInfo;
}

export interface IndicatorPanelProps {
  indicators: {
    ma5?: number;
    ma10?: number;
    ma20?: number;
    ma60?: number;
  };
  visible: boolean;
}

export interface TimeframeSelectorProps {
  value: Timeframe;
  onChange: (timeframe: Timeframe) => void;
}

export interface ToolbarProps {
  onZoomIn: () => void;
  onZoomOut: () => void;
  onReset: () => void;
}
