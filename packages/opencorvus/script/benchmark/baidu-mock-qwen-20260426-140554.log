/**
 * Baidu Homepage Clone - Interaction Logic
 * All API calls are mocked — no real network requests.
 * Imports from src/mock/ modules.
 */

import {
  getHotSearchList,
  refreshHotSearchList,
  getSearchSuggestions,
  getUserStatus,
  mockLogin,
  getAIRecommendations,
  openAIAssistant,
  reportAnalytics,
  trackPageView,
  trackAction,
} from './src/mock/index.js';

// ============================================
// DOM Elements
// ============================================
const searchInput = document.getElementById('searchInput');
const searchBtn = document.getElementById('searchBtn');
const loginBtn = document.getElementById('loginBtn');
const refreshBtn = document.getElementById('refreshBtn');
const aiPrompt = document.getElementById('aiPrompt');
const suggestionsDropdown = document.getElementById('suggestionsDropdown');
const hotListLeft = document.getElementById('hotListLeft');
const hotListRight = document.getElementById('hotListRight');
const toastEl = document.getElementById('toast');

// ============================================
// Toast utility
// ============================================
let toastTimer = null;

function showToast(message) {
  if (toastTimer) clearTimeout(toastTimer);
  toastEl.textContent = message;
  toastEl.classList.add('show');
  toastTimer = setTimeout(() => {
    toastEl.classList.remove('show');
  }, 2500);
}

// ============================================
// Hot Search List Rendering
// ============================================
function getRankClass(rank) {
  if (rank === 0) return 'rank-top';
  if (rank === 1) return 'rank-1';
  if (rank === 2) return 'rank-2';
  if (rank === 3) return 'rank-3';
  return '';
}

function getTagHTML(tag) {
  if (!tag || tag === 'top') return '';
  const cls = tag === '热' ? 'hot' : 'new';
  return `<span class="hot-tag ${cls}">${tag}</span>`;
}

function renderRankDisplay(item) {
  if (item.rank === 0) {
    return '<span class="hot-rank rank-top">↑</span>';
  }
  return `<span class="hot-rank ${getRankClass(item.rank)}">${item.rank}</span>`;
}

function renderHotSearchList(items) {
  const leftItems = items.slice(0, 5);
  const rightItems = items.slice(5);

  hotListLeft.innerHTML = leftItems.map(item => `
    <div class="hot-item" data-rank="${item.rank}" data-title="${item.title}">
      ${renderRankDisplay(item)}
      <span class="hot-text">${item.title}</span>
      ${getTagHTML(item.tag)}
    </div>
  `).join('');

  hotListRight.innerHTML = rightItems.map(item => `
    <div class="hot-item" data-rank="${item.rank}" data-title="${item.title}">
      ${renderRankDisplay(item)}
      <span class="hot-text">${item.title}</span>
      ${getTagHTML(item.tag)}
    </div>
  `).join('');

  // Bind click events on hot items
  document.querySelectorAll('.hot-item').forEach(el => {
    el.addEventListener('click', () => {
      const title = el.getAttribute('data-title');
      const rank = el.getAttribute('data-rank');
      console.log(`[Mock] 热搜点击 — 排名: ${rank}, 标题: ${title}`);
      showToast(`Mock: 搜索 "${title}"`);
      trackAction('hot_search_click', { rank, title });
    });
  });
}

// ============================================
// Search Suggestions
// ============================================
function showSuggestions(query) {
  const suggestions = getSearchSuggestions(query);
  if (suggestions.length === 0) {
    suggestionsDropdown.classList.remove('active');
    return;
  }
  suggestionsDropdown.innerHTML = suggestions.map(s =>
    `<div class="suggestion-item">${s}</div>`
  ).join('');
  suggestionsDropdown.classList.add('active');

  // Bind click on suggestions
  suggestionsDropdown.querySelectorAll('.suggestion-item').forEach(el => {
    el.addEventListener('click', () => {
      searchInput.value = el.textContent;
      suggestionsDropdown.classList.remove('active');
      handleSearch(el.textContent);
    });
  });
}

function hideSuggestions() {
  suggestionsDropdown.classList.remove('active');
}

// ============================================
// Search Handler
// ============================================
function handleSearch(query) {
  const q = query || searchInput.value.trim();
  if (!q) return;
  console.log(`[Mock] 搜索执行 — 关键词: ${q}`);
  showToast(`Mock: 搜索 "${q}" — 结果页已模拟`);
  reportAnalytics('search', { query: q });
  hideSuggestions();
}

// ============================================
// Event Bindings
// ============================================

// Search button click
searchBtn.addEventListener('click', () => {
  handleSearch();
});

// Enter key in search input
searchInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    handleSearch();
  }
});

// Input focus / input for suggestions
searchInput.addEventListener('focus', () => {
  showSuggestions(searchInput.value.trim());
});

searchInput.addEventListener('input', () => {
  showSuggestions(searchInput.value.trim());
});

// Click outside to close suggestions
document.addEventListener('click', (e) => {
  if (!e.target.closest('.search-area')) {
    hideSuggestions();
  }
});

// Login button
loginBtn.addEventListener('click', () => {
  const result = mockLogin();
  showToast(result.message);
  trackAction('login_click', {});
});

// Refresh hot search (换一换)
refreshBtn.addEventListener('click', () => {
  const newList = refreshHotSearchList();
  renderHotSearchList(newList);
  console.log('[Mock] 热搜列表已刷新');
  showToast('Mock: 热搜列表已刷新');
  trackAction('hot_search_refresh', {});
});

// AI prompt click
aiPrompt.addEventListener('click', () => {
  const result = openAIAssistant();
  showToast(result.message);
  trackAction('ai_assistant_click', {});
});

// Nav links
document.querySelectorAll('.nav-link').forEach(el => {
  el.addEventListener('click', () => {
    const nav = el.getAttribute('data-nav');
    console.log(`[Mock] 导航点击 — ${nav}`);
    showToast(`Mock: 导航到 "${nav}"`);
    trackAction('nav_click', { nav });
  });
});

// Footer links
document.querySelectorAll('.footer-link[data-footer]').forEach(el => {
  el.addEventListener('click', () => {
    const footer = el.getAttribute('data-footer');
    console.log(`[Mock] 底部链接点击 — ${footer}`);
    showToast(`Mock: 打开 "${footer}"`);
    trackAction('footer_click', { footer });
  });
});

// Footer icons
document.querySelectorAll('.footer-icon').forEach(el => {
  el.addEventListener('click', () => {
    const title = el.getAttribute('title');
    console.log(`[Mock] 底部图标点击 — ${title}`);
    showToast(`Mock: ${title}`);
  });
});

// Search tool buttons
document.getElementById('voiceBtn').addEventListener('click', () => {
  console.log('[Mock] 语音搜索按钮被点击');
  showToast('Mock: 语音搜索功能已打开');
  trackAction('voice_search_click', {});
});

document.getElementById('imageBtn').addEventListener('click', () => {
  console.log('[Mock] 图片搜索按钮被点击');
  showToast('Mock: 图片搜索功能已打开');
  trackAction('image_search_click', {});
});

// ============================================
// Initialization
// ============================================
function init() {
  // Track page view
  trackPageView('baidu_homepage');

  // Render hot search list from mock data
  const hotList = getHotSearchList();
  renderHotSearchList(hotList);

  // Check user status (mock)
  const userStatus = getUserStatus();
  if (userStatus.loggedIn) {
    loginBtn.textContent = userStatus.nickname || '用户';
  }

  // Log initialization
  console.log('[Mock] 百度首页已加载 — 所有API已Mock，无真实网络请求');

  // Set placeholder for search input
  searchInput.placeholder = '李小冉自曝洗头需心理建设';
}

