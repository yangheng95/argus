INFO  2026-04-27T16:27:22 +0ms service=decision-log taskID=tsk_dcfbb09d1001fAjQU1pHKlyYpS key=interface_contract value=## Backend API types for stock data
```typescript
// src/backend/types/index.ts

export interface StockInfo {
  symbol: string;
  name: string;
  exchange: string;
  logo: string;
  currentPrice: number;
  change: number;
  changePercent: number;
  marketOpen: string;
  preMarket: string;
  high: number;
  low: number;
  volume: number;
  turnover: number;
  bid: number;
  ask: number;
  buySellRatio: number; // 0-100, percentage of buy orders
}

export interface CandleData {
  time: number; // Unix timestamp in seconds
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

export interface Indicators {
  ma20: number[];
  ma50: number[];
  ma200: number[];
  rsi: number[];
  macd: { macd: number[]; signal: number[]; histogram: number[] };
  bollinger: { upper: number[]; middle: number[]; lower: number[] };
}

export interface Quote {
  symbol: string;
  price: number;
  bid: number;
  ask: number;
  volume: number;
  timestamp: number;
}

// Virtual data engine functions
export declare function generateCandles(
  symbol: string,
  timeframe: '1m' | '5m' | '15m' | '1h' | '1d' | '1w',
  count: number,
  basePrice?: number
): CandleData[];

export declare function generateIndicators(candles: CandleData[]): Indicators;

export declare function generateQuote(symbol: string, basePrice?: number): Quote;
``` phase=architect decision logged
INFO  2026-04-27T16:27:22 +0ms service=decision-log taskID=tsk_dcfbb09d1001fAjQU1pHKlyYpS key=directory_blueprint value=## Project directory structure
```text
mirror/                          # Webpage extraction artifacts
  reference.png                  # Screenshot of target page
  extracted-page.json            # Extracted DOM and CSS data
  page-ir.xml                    # Compiled intermediate representation
  scaffold.json                  # Project scaffold with component tree
  design-tokens.ts               # Design tokens (colors, typography, spacing)
  shared-context.md              # Implementation context
  App.tsx                        # Suggested App component scaffold
  images/                        # Downloaded assets

src/
  backend/                       # Hono backend API
    index.ts                     # Server entry point
    routes/
      stock.ts                   # Stock API routes
    data-engine/
      generator.ts               # Virtual data generation engine
      indicators.ts              # Technical indicators calculation
    types/
      index.ts                   # Shared types
    tsconfig.json                # Backend TypeScript config

  frontend/                      # React frontend
    main.tsx                     # React app entry
    App.tsx                      # Root App component
    components/                  # UI components
      TopNav.tsx                 # Top navigation bar
      LeftSidebar.tsx            # Drawing tools sidebar
      RightPanel.tsx             # Watchlist and stock info
      Watchlist.tsx              # Watchlist with collapsible groups
      StockInfo.tsx              # Stock info with tabs
      PriceDisplay.tsx           # Current price display
      MarketData.tsx             # Market data grid
      BuySellBar.tsx             # Buy/sell ratio bar
      BidAskRow.tsx              # Bid/ask row
      CookieBanner.tsx           # Cookie consent banner
      TabNav.tsx                 # Tab navigation
    chart/                       # TradingView chart integration
      ChartComponent.tsx         # K-line chart wrapper
      ChartControls.tsx          # Chart controls (timeframe, indicators)
    hooks/                       # React hooks
      useStockData.ts            # Fetch stock data
      useWebSocket.ts            # WebSocket connection
    types/
      index.ts                   # Frontend types
    styles/
      index.css                  # Global styles

tests/
  integration/                   # Integration tests
    api-integration.test.ts      # API integration tests
    data-flow.test.ts            # Data flow tests
  e2e/                           # E2E tests
    chart-interaction.test.ts    # Chart interaction E2E
    watchlist.test.ts            # Watchlist E2E

index.html                       # HTML entry point
package.json                     # Project dependencies
tsconfig.json                    # Root TypeScript config
tailwind.config.js               # Tailwind CSS config
vite.config.ts                   # Vite build config
``` phase=architect decision logged
INFO  2026-04-27T16:27:22 +1ms service=decision-log taskID=tsk_dcfbb09d1001fAjQU1pHKlyYpS key=naming_convention value=## File and component naming conventions
- React components: PascalCase (e.g., `TopNav.tsx`, `ChartComponent.tsx`)
- Utility files: camelCase (e.g., `generator.ts`, `indicators.ts`)
- React hooks: camelCase with 'use' prefix (e.g., `useStockData.ts`)
- Types/interfaces: PascalCase in dedicated files or `types/index.ts`
- Test files: `*.test.ts` or `*.test.tsx` adjacent to implementation
- Backend routes: kebab-case files with camelCase handlers
