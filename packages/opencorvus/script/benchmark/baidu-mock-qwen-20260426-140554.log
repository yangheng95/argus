// mirror/page-ir.xml           — compact XML IR of the page structure
// mirror/scaffold.json          — ProjectScaffold with layout patterns
// mirror/design-tokens.ts       — design tokens (colors, spacing, typography)
// mirror/shared-context.md      — shared context for implementation

// goal_impl consumes these files as authoritative design source.
// goal_impl reads mirror/design-tokens.ts for color/spacing/typography values.
// goal_impl reads mirror/scaffold.json for layout structure.
// goal_impl reads mirror/shared-context.md for component relationships.
