  font-size: 14px;
  font-weight: 700;
  color: #222222;
  cursor: pointer;
}

.hot-search-title:hover {
  color: #4e6ef2;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: #9195a3;
  transition: color 0.2s;
}

.refresh-btn:hover {
  color: #4e6ef2;
}

.hot-list-grid {
  display: flex;
  gap: 40px;
}

.hot-list-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hot-item {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 24px;
  cursor: pointer;
  transition: opacity 0.15s;
}

.hot-item:hover {
  opacity: 0.7;
}

.hot-rank {
  font-family: Arial, sans-serif;
  font-size: 16px;
  font-weight: 700;
  color: #9195a3;
  min-width: 20px;
  text-align: center;
}

.hot-rank.rank-1 {
  color: #f54545;
}

.hot-rank.rank-2 {
  color: #ff8547;
}

.hot-rank.rank-3 {
  color: #ffac38;
}

.hot-rank.rank-top {
  color: #f54545;
  font-size: 14px;
}

.hot-text {
  font-size: 14px;
  font-weight: 400;
  color: #222222;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.hot-tag {
  font-size: 10px;
  font-weight: 400;
  color: #ffffff;
  padding: 1px 4px;
  border-radius: 2px;
  white-space: nowrap;
}

.hot-tag.hot {
  background: #ff6633;
}

.hot-tag.new {
  background: #ff3333;
}

/* ============================================
   Footer
   ============================================ */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  height: 60px;
  padding: 0 24px;
  background: #ffffff;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 12px;
  font-weight: 400;
  color: #999999;
  white-space: nowrap;
  transition: color 0.2s;
}

.footer-link:hover {
  color: #4e6ef2;
}

.footer-icon {
  display: flex;
  align-items: center;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.footer-icon:hover {
  opacity: 1;
}

/* ============================================
   Toast Notification
   ============================================ */
.toast {
  position: fixed;
  top: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(-20px);
  padding: 12px 24px;
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  font-size: 14px;
  border-radius: 8px;
  opacity: 0;
  transition: opacity 0.3s, transform 0.3s;
  pointer-events: none;
  z-index: 1000;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ============================================
   Responsive adjustments
   ============================================ */
@media (max-width: 768px) {
  .nav-left {
    gap: 12px;
  }

  .nav-link {
    font-size: 12px;
  }

  .search-area {
    max-width: 90%;
  }

  .hot-list-grid {
    flex-direction: column;
    gap: 16px;
  }

  .footer {
    gap: 8px;
    height: auto;
    padding: 16px;
  }
}
