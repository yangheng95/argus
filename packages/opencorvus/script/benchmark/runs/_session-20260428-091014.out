```text
mirror/                     # Mirror toolchain artifacts
├── extracted-page.json     # Raw extraction from webpage
├── reference.png           # Reference screenshot
├── page-ir.xml            # Compiled intermediate representation
├── scaffold.json          # Component hierarchy
├── design-tokens.ts       # Design system tokens (colors, typography, spacing)
├── App.tsx                # Skeleton React app
└── shared-context.md      # Implementation notes

src/                        # Source code
├── data-engine/           # Virtual data generation
│   ├── types.ts           # Data type definitions
│   ├── generator.ts       # OHLCV generation algorithms
│   ├── indicators.ts      # MA, MACD, RSI calculations
│   ├── stocks.ts          # Stock metadata
│   ├── index.ts           # Public exports
│   └── __tests__/         # Unit tests
├── api/                   # Hono backend API
│   ├── server.ts          # Server entry point
│   ├── routes/
│   │   ├── stock.ts       # Stock data routes
│   │   └── stocks.ts      # Stock list routes
│   ├── middleware/
│   │   ├── cors.ts        # CORS middleware
│   │   └── error.ts       # Error handling
│   ├── types.ts           # API type definitions
│   └── __tests__/         # Unit tests
└── frontend/              # React frontend
    ├── index.html         # HTML entry
    ├── main.tsx           # React entry
    ├── App.tsx            # Main app component
    ├── vite.config.ts     # Vite config
    ├── tailwind.config.ts # Tailwind config
    ├── components/
    │   ├── ui/            # shadcn/ui components
    │   ├── layout/        # Layout components (Header, Sidebars)
    │   ├── chart/         # Chart components
    │   └── stock/         # Stock info components
    ├── hooks/             # React hooks
    ├── lib/               # Utilities
    ├── styles/            # Global styles
    └── __tests__/         # Component tests

tests/                      # Integration and E2E tests
├── integration/           # API integration tests
├── e2e/                   # End-to-end tests
└── regression/            # Regression tests
``` phase=architect decision logged
