```ts
// frontend/src/types/index.ts & backend/src/types/index.ts

export interface Stock {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  volume: number;
  high: number;
  low: number;
  open: number;
  close: number;
  marketStatus: 'open' | 'closed' | 'extended';
  exchange: string;
}

export interface ChartData {
  time: number;
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

export interface TechnicalIndicator {
  name: string;
  type: 'ma' | 'macd' | 'rsi' | 'bollinger' | 'volume';
  data: Array<{ time: number; value: number } | { time: number; upper: number; middle: number; lower: number }>;
  visible: boolean;
  params?: Record<string, number>;
}

export type TimeRange = '1D' | '1W' | '1M' | '3M' | '6M' | '1Y' | '5Y' | 'ALL';

export interface WatchlistItem {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
  category: 'stocks' | 'crypto';
}

export interface StockQuote {
  symbol: string;
  price: number;
  change: number;
  changePercent: number;
  timestamp: number;
}
