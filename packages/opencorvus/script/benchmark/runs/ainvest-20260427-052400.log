// src/server/index.ts
import { Hono } from 'hono';
import type { StockInfo, OHLCData, Indicator, BuySellRatio } from '../types/api';

const app = new Hono();

// GET /api/stocks/:symbol - Get stock information
app.get('/api/stocks/:symbol', (c) => {
  const symbol = c.req.param('symbol');
  // Returns StockInfo
});

// GET /api/stocks/:symbol/ohlc - Get OHLC candlestick data
app.get('/api/stocks/:symbol/ohlc', (c) => {
  const symbol = c.req.param('symbol');
  const timeframe = c.req.query('timeframe') || '1D';
  // Returns OHLCData[]
});

// GET /api/stocks/:symbol/price - Get current price
app.get('/api/stocks/:symbol/price', (c) => {
  const symbol = c.req.param('symbol');
  // Returns { price: number, change: number, changePercent: number }
});

// GET /api/stocks/:symbol/stats - Get stock statistics
app.get('/api/stocks/:symbol/stats', (c) => {
  const symbol = c.req.param('symbol');
  // Returns StockStats
});

// GET /api/stocks/:symbol/buysell - Get buy/sell ratio
app.get('/api/stocks/:symbol/buysell', (c) => {
  const symbol = c.req.param('symbol');
  // Returns BuySellRatio
});

// GET /api/indicators - Get available technical indicators
app.get('/api/indicators', (c) => {
  // Returns Indicator[]
});

export default app;
