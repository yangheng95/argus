```ts
// Backend types (consumed by frontend)

interface StockInfo {
  symbol: string;
  name: string;
  exchange: string;
  price: number;
  change: number;
  changePercent: number;
  afterHoursPrice?: number;
  afterHoursChange?: number;
  timestamp: string;
}

interface KlineData {
  time: number;  // Unix timestamp
  open: number;
  high: number;
  low: number;
  close: number;
  volume: number;
}

interface IndicatorData {
  ma1: number;  // 5-day MA - #8B5CF6
  ma2: number;  // 10-day MA - #F97316
  ma3: number;  // 20-day MA - #22C55E
  ma4: number;  // 30-day MA - #3B82F6
  ma5: number;  // 60-day MA - #EF4444
  timestamp: number;
}

interface MarketIndex {
  symbol: string;
  name: string;
  price: number;
  changePercent: number;
}

interface WatchlistItem {
  symbol: string;
  name: string;
  price: number;
  change: number;
  changePercent: number;
}

type Timeframe = '1D' | '1W' | '1M' | '3M' | '6M' | '1Y' | '5Y';
``` phase=architect decision logged
INFO  2026-04-26T14:30:03 +1ms service=decision-log taskID=tsk_dca29dd9a001n6qhACJz6UFoor key=interface_contract value=## Backend API Routes
```ts
// src/backend/routes/stock.ts
// Hono route handlers

// GET /api/stock/:symbol - Get stock information
app.get('/api/stock/:symbol', (c) => {
  const symbol = c.req.param('symbol');
  return c.json<StockInfo>({ /* ... */ });
});

// GET /api/klines/:symbol?timeframe=1D - Get K-line data
app.get('/api/klines/:symbol', (c) => {
  const symbol = c.req.param('symbol');
  const timeframe = c.req.query('timeframe') as Timeframe || '1D';
  return c.json<KlineData[]>([ /* ... */ ]);
});

// GET /api/indicators/:symbol - Get technical indicators
app.get('/api/indicators/:symbol', (c) => {
  const symbol = c.req.param('symbol');
  return c.json<IndicatorData[]>([ /* ... */ ]);
});

// GET /api/market/indices - Get market indices (DIA, QQQ, SPY)
app.get('/api/market/indices', (c) => {
  return c.json<MarketIndex[]>([ /* ... */ ]);
});

// GET /api/watchlist - Get watchlist data
app.get('/api/watchlist', (c) => {
  return c.json<WatchlistItem[]>([ /* ... */ ]);
});

// Health check
app.get('/api/health', (c) => c.json({ status: 'ok' }));
