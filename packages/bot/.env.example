# ============================================================
# Argus Bot — 环境变量配置示例
# 复制为 .env 后填写，然后运行 bun dev 启动 Bot
# ============================================================

# ---- DashScope API Key（选其一）----
# sk-sp-* 前缀 → Coding Plan endpoint (DASHSCOPE_CODING_BASE_URL)
# sk-*    前缀 → 标准 intl endpoint (DASHSCOPE_INTL_BASE_URL)
CODING_DASHSCOPE_API_KEY=sk-sp-...
# DASHSCOPE_API_KEY=sk-...

# ---- DashScope Endpoint URL（按 key 前缀自动路由）----
DASHSCOPE_CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/api/v1
DASHSCOPE_INTL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ---- LLM 默认模型（无交互提示时使用）----
ARGUS_DEFAULT_MODEL=alibaba-cn/qwen3.5-plus

# ---- 各 Provider 交互提示的默认模型（可选）----
ARGUS_MODEL_ALIBABA=alibaba-cn/qwen3.5-plus
# ARGUS_MODEL_ANTHROPIC=anthropic/claude-sonnet-4-6
# ARGUS_MODEL_OPENAI=openai/gpt-4o
# ARGUS_MODEL_GOOGLE=google/gemini-2.5-pro
# ARGUS_MODEL_DEEPSEEK=deepseek/deepseek-chat
# ARGUS_MODEL_OPENROUTER=openrouter/anthropic/claude-sonnet-4

# ---- Vision 模型（使用 DashScope API Key）----
ARGUS_VISION_MODEL=qwen3.5-plus

# ---- 其他 LLM Provider API Key（可选）----
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=...

# ---- Slack 适配器（与 Telegram 二选一，或同时配置）----
# Slack App 需开启 Socket Mode，并订阅 message.channels / message.im 事件
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# ---- Telegram 适配器（可选）----
# TELEGRAM_BOT_TOKEN=...

# ---- 语音识别 STT（可选，全部不填则禁用）----
# 优先顺序由 STT_PROVIDERS 控制
# STT_PROVIDERS=groq,openai-whisper,deepgram,google-gemini,local-cli
# STT_LANGUAGE=zh

# Groq STT
# GROQ_API_KEY=gsk_...
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Whisper STT
# STT_OPENAI_MODEL=whisper-1
# STT_OPENAI_BASE_URL=https://api.openai.com/v1

# Deepgram STT
# DEEPGRAM_API_KEY=...
# STT_DEEPGRAM_MODEL=nova-2
# STT_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1

# Google Gemini STT
# GOOGLE_API_KEY=...
# STT_GOOGLE_MODEL=gemini-2.0-flash
# STT_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local CLI STT
# STT_LOCAL_COMMAND=whisper

# ---- 其他（可选）----
# TUI_PROJECT_DIR=D:/my-project
