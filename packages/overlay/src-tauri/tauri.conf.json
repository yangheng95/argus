{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openlens-overlay",
  "version": "0.1.0",
  "identifier": "dev.openlens.overlay",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "openlens-overlay",
        "url": "index.html",
        "width": 380,
        "height": 160,
        "x": -9999,
        "y": -9999,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "window-highlight",
        "title": "argus-window-highlight",
        "url": "window-highlight.html",
        "width": 640,
        "height": 420,
        "x": -9999,
        "y": -9999,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "confirm",
        "title": "argus-confirm",
        "url": "confirm.html",
        "width": 460,
        "height": 220,
        "x": -9999,
        "y": -9999,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "resizable": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "console",
        "title": "Argus Console",
        "url": "manager.html",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  }
}
